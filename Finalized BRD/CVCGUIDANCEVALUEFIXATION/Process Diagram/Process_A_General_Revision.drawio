<mxfile host="app.diagrams.net" type="device"><diagram id="Process A - General Revision" name="Process A - General Revision"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1710" pageHeight="3724" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lane_cvc" value="Central Valuation Committee (CVC)&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px'&gt;Chairman: IGR&lt;/span&gt;" style="swimlane;horizontal=1;html=1;startSize=64;whiteSpace=wrap;fillColor=#dae8fc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="90" width="250" height="3444" as="geometry"/></mxCell><mxCell id="lane_sec" value="CVC Secretary&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px'&gt;DIGR (Valuation)&lt;/span&gt;" style="swimlane;horizontal=1;html=1;startSize=64;whiteSpace=wrap;fillColor=#d5e8d4;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="250" y="90" width="240" height="3444" as="geometry"/></mxCell><mxCell id="lane_dr" value="District Registrar (DR)" style="swimlane;horizontal=1;html=1;startSize=64;whiteSpace=wrap;fillColor=#fff2cc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="490" y="90" width="240" height="3444" as="geometry"/></mxCell><mxCell id="lane_sc" value="Market Valuation Sub-Committee&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px'&gt;Chairman: Tahsildar&lt;/span&gt;" style="swimlane;horizontal=1;html=1;startSize=64;whiteSpace=wrap;fillColor=#ffe6cc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="730" y="90" width="240" height="3444" as="geometry"/></mxCell><mxCell id="lane_sr" value="Sub-Committee Secretary&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px'&gt;Sub-Registrar (SR)&lt;/span&gt;" style="swimlane;horizontal=1;html=1;startSize=64;whiteSpace=wrap;fillColor=#f8cecc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="970" y="90" width="240" height="3444" as="geometry"/></mxCell><mxCell id="lane_pub" value="Public / Citizens" style="swimlane;horizontal=1;html=1;startSize=64;whiteSpace=wrap;fillColor=#e1d5e7;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1210" y="90" width="230" height="3444" as="geometry"/></mxCell><mxCell id="lane_sys" value="Kaveri System" style="swimlane;horizontal=1;html=1;startSize=64;whiteSpace=wrap;fillColor=#f5f5f5;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1440" y="90" width="230" height="3444" as="geometry"/></mxCell><mxCell id="title" value="&lt;b style='font-size:20px'&gt;Process A — General Revision of Guidance Value&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;Based on Rules 5 and 7 of the Karnataka Stamp (Central Valuation Committee) Rules, 2003 — BRD CVC Guidance Value Fixation v1.7&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="1670" height="70" as="geometry"/></mxCell><mxCell id="a_start" value="Start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="199" width="70" height="70" as="geometry"/></mxCell><mxCell id="a1" value="&lt;b&gt;1.&lt;/b&gt; Send instructions and rate-fixing guidelines to all Sub-Committees for next year (or to one Sub-Committee during the year)&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Rule 5(1)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="344" width="190" height="100" as="geometry"/></mxCell><mxCell id="a2" value="&lt;b&gt;2.&lt;/b&gt; Announce the plan to revise rates in local newspapers and on office notice boards&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Rule 5(2)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="755" y="504" width="190" height="100" as="geometry"/></mxCell><mxCell id="a3" value="&lt;b&gt;3.&lt;/b&gt; Send objections or suggestions within 15 days&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Rule 5(2)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1230" y="664" width="190" height="100" as="geometry"/></mxCell><mxCell id="a4" value="&lt;b&gt;4.&lt;/b&gt; Sort the objections and suggestions and place them before the Sub-Committee&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Rule 5(2)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="995" y="824" width="190" height="100" as="geometry"/></mxCell><mxCell id="a5" value="&lt;b&gt;5.&lt;/b&gt; Meet as often as needed, consider public views and decide the new rates&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Rule 5(2)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="755" y="984" width="190" height="100" as="geometry"/></mxCell><mxCell id="a6" value="&lt;b&gt;6.&lt;/b&gt; Prepare the statement of average rates, village-wise and local-body-wise&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Rule 5(2)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="755" y="1144" width="190" height="100" as="geometry"/></mxCell><mxCell id="a7" value="&lt;b&gt;7.&lt;/b&gt; Chairman and Secretary sign the statement in CVC format, with views on objections&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Rule 5(2)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="755" y="1304" width="190" height="100" as="geometry"/></mxCell><mxCell id="a8" value="&lt;b&gt;8.&lt;/b&gt; Send printed booklet and soft copy to the District Registrar&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Rule 5(2)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="995" y="1464" width="190" height="100" as="geometry"/></mxCell><mxCell id="a9" value="&lt;b&gt;9.&lt;/b&gt; Check statement: any mistakes or missing data?&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Rule 5(3)&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="512" y="1612" width="196" height="124" as="geometry"/></mxCell><mxCell id="a10" value="&lt;b&gt;10.&lt;/b&gt; Correct the mistakes / add missing data and send back within 15 days&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Rule 5(3)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="755" y="1624" width="190" height="100" as="geometry"/></mxCell><mxCell id="a11" value="&lt;b&gt;11.&lt;/b&gt; Final review, add remarks, send a separate booklet and soft copy for each sub-district&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Rule 5(3)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="515" y="1784" width="190" height="100" as="geometry"/></mxCell><mxCell id="a12" value="&lt;b&gt;12.&lt;/b&gt; Check the statements and place them before the CVC&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Rule 7(1)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="275" y="1944" width="190" height="100" as="geometry"/></mxCell><mxCell id="a13" value="&lt;b&gt;13.&lt;/b&gt; Discuss district-wise rates, accept or reject suggestions, record decisions in the minutes&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Rule 7(2)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="2104" width="190" height="100" as="geometry"/></mxCell><mxCell id="a13d" value="Rates approved?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="27" y="2252" width="196" height="124" as="geometry"/></mxCell><mxCell id="a14" value="&lt;b&gt;14.&lt;/b&gt; Certify (attest) the approved statements and send them to the DR&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Rule 7(3)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="275" y="2424" width="190" height="100" as="geometry"/></mxCell><mxCell id="a14b" value="&lt;b&gt;14.&lt;/b&gt; Forward to Sub-Committees; keep copies for the public at the DR office&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Rule 7(3)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="515" y="2584" width="190" height="100" as="geometry"/></mxCell><mxCell id="a15" value="&lt;b&gt;15.&lt;/b&gt; Display approved rates in sub-district offices and SR office; printed copies sold at CVC price&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Rule 7(3)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="755" y="2744" width="190" height="100" as="geometry"/></mxCell><mxCell id="a16" value="&lt;b&gt;16.&lt;/b&gt; Fix the date from which the new rates apply (effective date)&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Kaveri system step&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="2904" width="190" height="100" as="geometry"/></mxCell><mxCell id="a17" value="&lt;b&gt;17.&lt;/b&gt; Publish in the e-Gazette through DIPR / Karnataka Rajya Patra&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Kaveri system step&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1460" y="3064" width="190" height="100" as="geometry"/></mxCell><mxCell id="a18" value="&lt;b&gt;18.&lt;/b&gt; Start using the new rates in Kaveri from the effective date; keep old rates for history&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Kaveri system step&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1460" y="3224" width="190" height="100" as="geometry"/></mxCell><mxCell id="a_end" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1520" y="3399" width="70" height="70" as="geometry"/></mxCell><mxCell id="e_a_start_a1_30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a_start" target="a1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_a1_a2_31" value="Instructions" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_a2_a3_32" value="Public notice" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_a3_a4_33" value="After 15 days" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_a4_a5_34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a4" target="a5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_a5_a6_35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a5" target="a6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_a6_a7_36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a6" target="a7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_a7_a8_37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a7" target="a8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_a8_a9_38" value="Booklet + soft copy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="a8" target="a9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_a9_a10_39" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#b85450;fontColor=#b85450;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="a9" target="a10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_a10_a9_40" value="Resubmit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.7;entryX=1;entryY=0.7;" edge="1" parent="1" source="a10" target="a9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_a9_a11_41" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a9" target="a11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_a11_a12_42" value="To CVC Secretary" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a11" target="a12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_a12_a13_43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a12" target="a13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_a13_a13d_44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a13" target="a13d"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_a13d_a12_45" value="No — needs clarification" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#b85450;fontColor=#b85450;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="a13d" target="a12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="14" y="2314"/><mxPoint x="14" y="1994"/></Array><mxPoint x="80" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e_a13d_a14_46" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a13d" target="a14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_a14_a14b_47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a14" target="a14b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_a14b_a15_48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a14b" target="a15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_a15_a16_49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a15" target="a16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_a16_a17_50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a16" target="a17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_a17_a18_51" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a17" target="a18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_a18_a_end_52" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a18" target="a_end"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="legend_t" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;align=left;" vertex="1" parent="1"><mxGeometry x="0" y="3564" width="120" height="24" as="geometry"/></mxCell><mxCell id="legend_0" value="Start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="3594" width="70" height="70" as="geometry"/></mxCell><mxCell id="legend_1" value="Step done by the actor in that lane" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="94" y="3594" width="150" height="56" as="geometry"/></mxCell><mxCell id="legend_2" value="Decision / check" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="268" y="3594" width="150" height="56" as="geometry"/></mxCell><mxCell id="legend_3" value="Kaveri system step (added for Kaveri, not in the Rules)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="442" y="3594" width="150" height="56" as="geometry"/></mxCell><mxCell id="legend_4" value="Rejection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="616" y="3594" width="150" height="56" as="geometry"/></mxCell><mxCell id="legend_5" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="790" y="3594" width="70" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>