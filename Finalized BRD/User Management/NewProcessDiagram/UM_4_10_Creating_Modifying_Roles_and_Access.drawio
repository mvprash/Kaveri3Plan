<mxfile host="app.diagrams.net" type="device"><diagram id="UM_4_10_Creating_Modifying_Roles_and_Access" name="UM_4_10_Creating_Modifying_Roles_and_Access"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1080" pageHeight="1470" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lane_adm" value="Authorised Administrator" style="swimlane;horizontal=1;html=1;startSize=60;whiteSpace=wrap;fillColor=#dae8fc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="90" width="260" height="1200" as="geometry"/></mxCell><mxCell id="lane_dom" value="Domain Expert" style="swimlane;horizontal=1;html=1;startSize=60;whiteSpace=wrap;fillColor=#d5e8d4;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="260" y="90" width="260" height="1200" as="geometry"/></mxCell><mxCell id="lane_sys" value="Kaveri System" style="swimlane;horizontal=1;html=1;startSize=60;whiteSpace=wrap;fillColor=#fff2cc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="520" y="90" width="260" height="1200" as="geometry"/></mxCell><mxCell id="lane_usr" value="User" style="swimlane;horizontal=1;html=1;startSize=60;whiteSpace=wrap;fillColor=#ffe6cc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="780" y="90" width="260" height="1200" as="geometry"/></mxCell><mxCell id="title" value="&lt;b style='font-size:20px'&gt;4.10 Creating / Modifying Roles and Their Access&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;BRD User Management (Simplified) v1.5 — requirements UM-ROL-01 to 10&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="1040" height="70" as="geometry"/></mxCell><mxCell id="s" value="Start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="98" y="188" width="64" height="64" as="geometry"/></mxCell><mxCell id="r1" value="&lt;b&gt;1.&lt;/b&gt; Add, change or deactivate a role and choose its category: Citizen, DSR or Other Department&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-ROL-01, 03&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="315" width="200" height="90" as="geometry"/></mxCell><mxCell id="r2" value="&lt;b&gt;2.&lt;/b&gt; Set which modules and functions (View, Add, Edit, Approve, Sign, Print, Download) the role may use&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-ROL-06&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="455" width="200" height="90" as="geometry"/></mxCell><mxCell id="r3" value="&lt;b&gt;3.&lt;/b&gt; Confirm the starting list of roles before go-live&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-ROL-03&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="595" width="200" height="90" as="geometry"/></mxCell><mxCell id="r4" value="&lt;b&gt;4.&lt;/b&gt; Save the role and record who changed it and when&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-ROL-09&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="550" y="735" width="200" height="90" as="geometry"/></mxCell><mxCell id="r5" value="&lt;b&gt;5.&lt;/b&gt; Give roles to users of the matching category (DSR Officer: one or more; Other Department user: one)&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-ROL-07, 10&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="875" width="200" height="90" as="geometry"/></mxCell><mxCell id="r6" value="&lt;b&gt;6.&lt;/b&gt; Sees and does only what the role allows; anything else is refused and recorded&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-ROL-08&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="1015" width="200" height="90" as="geometry"/></mxCell><mxCell id="e" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="878" y="1168" width="64" height="64" as="geometry"/></mxCell><mxCell id="e_s_r1_13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s" target="r1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_r1_r2_14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="r1" target="r2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_r2_r3_15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="r2" target="r3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_r3_r4_16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="r3" target="r4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_r5_r6_17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="r5" target="r6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_r6_e_18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="r6" target="e"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_r4_r5_19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="r4" target="r5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="legend_t" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;align=left;" vertex="1" parent="1"><mxGeometry x="0" y="1320" width="120" height="24" as="geometry"/></mxCell><mxCell id="legend_0" value="Start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="1350" width="64" height="64" as="geometry"/></mxCell><mxCell id="legend_1" value="Step done by the person or system in that lane" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="84" y="1350" width="140" height="56" as="geometry"/></mxCell><mxCell id="legend_2" value="Check / choice" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="244" y="1350" width="140" height="56" as="geometry"/></mxC