<mxfile host="app.diagrams.net" type="device"><diagram id="UM_4_07_Additional_Charge" name="UM_4_07_Additional_Charge"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="800" pageHeight="1470" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lane_off" value="DSR Officer" style="swimlane;horizontal=1;html=1;startSize=60;whiteSpace=wrap;fillColor=#dae8fc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="90" width="260" height="1200" as="geometry"/></mxCell><mxCell id="lane_sys" value="Kaveri System" style="swimlane;horizontal=1;html=1;startSize=60;whiteSpace=wrap;fillColor=#d5e8d4;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="260" y="90" width="500" height="1200" as="geometry"/></mxCell><mxCell id="title" value="&lt;b style='font-size:20px'&gt;4.7 Additional Charge (after sign-in)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;BRD User Management (Simplified) v1.8 — requirements UM-ADC-01 to 05&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="760" height="70" as="geometry"/></mxCell><mxCell id="s" value="Start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="98" y="188" width="64" height="64" as="geometry"/></mxCell><mxCell id="a1" value="&lt;b&gt;1.&lt;/b&gt; Sign in and select the post&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-LOG-09&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="315" width="200" height="90" as="geometry"/></mxCell><mxCell id="a2" value="&lt;b&gt;2.&lt;/b&gt; Look for posts directly under the officer, in the same office, that nobody holds&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-ADC-01, 02&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="455" width="200" height="90" as="geometry"/></mxCell><mxCell id="a2d" value="Any such post?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="585" width="200" height="110" as="geometry"/></mxCell><mxCell id="rej" value="No additional charge is offered&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-ADC-01&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="535" y="595" width="200" height="90" as="geometry"/></mxCell><mxCell id="a3" value="&lt;b&gt;3.&lt;/b&gt; Select one post to take charge of (no order needed; one at a time)&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-ADC-03&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="735" width="200" height="90" as="geometry"/></mxCell><mxCell id="a4" value="&lt;b&gt;4.&lt;/b&gt; Switch to that post. Header shows the active post; only its work is allowed&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-ADC-04, 05&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="875" width="200" height="90" as="geometry"/></mxCell><mxCell id="a5" value="&lt;b&gt;5.&lt;/b&gt; Switch back to own post at any time, without signing out&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-ADC-04&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="1015" width="200" height="90" as="geometry"/></mxCel