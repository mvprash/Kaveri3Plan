<mxfile host="app.diagrams.net" type="device"><diagram id="UM_4_03_Other_Department_User_Registration" name="UM_4_03_Other_Department_User_Registration"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="820" pageHeight="1610" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lane_adm" value="Authorised Administrator" style="swimlane;horizontal=1;html=1;startSize=60;whiteSpace=wrap;fillColor=#dae8fc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="90" width="260" height="1340" as="geometry"/></mxCell><mxCell id="lane_sys" value="Kaveri System" style="swimlane;horizontal=1;html=1;startSize=60;whiteSpace=wrap;fillColor=#d5e8d4;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="260" y="90" width="260" height="1340" as="geometry"/></mxCell><mxCell id="lane_odu" value="Other Department User" style="swimlane;horizontal=1;html=1;startSize=60;whiteSpace=wrap;fillColor=#fff2cc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="520" y="90" width="260" height="1340" as="geometry"/></mxCell><mxCell id="title" value="&lt;b style='font-size:20px'&gt;4.3 Other Department User Registration&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;BRD User Management (Simplified) v1.8 — requirements UM-ODU-01 to 05&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="780" height="70" as="geometry"/></mxCell><mxCell id="s" value="Start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="98" y="188" width="64" height="64" as="geometry"/></mxCell><mxCell id="o1" value="&lt;b&gt;1.&lt;/b&gt; Select the department&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-ODU-01, 02&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="315" width="200" height="90" as="geometry"/></mxCell><mxCell id="o2" value="&lt;b&gt;2.&lt;/b&gt; Enter Employee ID or KGID, official email and mobile&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-ODU-02&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="455" width="200" height="90" as="geometry"/></mxCell><mxCell id="o2d" value="Official email allowed and not already registered?&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-ODU-02, 03&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="585" width="200" height="110" as="geometry"/></mxCell><mxCell id="o3" value="&lt;b&gt;3.&lt;/b&gt; Choose one Other Department role; add an End Date if needed&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-ODU-04, 05&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="735" width="200" height="90" as="geometry"/></mxCell><mxCell id="o4" value="&lt;b&gt;4.&lt;/b&gt; Create the account. Username = department code + ID (e.g. REV-12345)&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-ODU-02&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="875" width="200" height="90" as="geometry"/></mxCell><mxCell id="o5" value="&lt;b&gt;5.&lt;/b&gt; Sign in with Username, Captcha and OTP&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-LOG-02&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="550" y="1015" width="200" height="90" as="geometry"/></mxCell><mxCell id="o6" value="&lt;b&gt;6.&lt;/b&gt; Stop the account automatically on the End Date (if given)&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-ODU-05&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="1155" width="200" height="90" as="geometry"/></mxCell><mxCell id="e" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="358" y="1308" width="64" height="64" as="geometry"/></mxCell><mxCell id="e_s_o1_13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s" target="o1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_o1_o2_14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="o1" target="o2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_o2_o2d_15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="o2" target="o2d"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_o2d_o2_16" value="No — personal or already-registered email refused" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#b85450;fontColor=#b85450;exitX=0.5;exitY=0;entryX=1;entryY=0.5;" edge="1" parent="1" source="o2d" target="o2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_o2d_o3_17" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="o2d" target="o3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_o3_o4_18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="o3" target="o4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_o4_o5_19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="o4" target="o5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_o5_o6_20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="o5" target="o6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_o6_e_21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="o6" target="e"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="legend_t" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;align=left;" vertex="1" parent="1"><mxGeometry x="0" y="1460" width="120" height="24" as="geometry"/></mxCell><mxCell id="legend_0" value="Start" style="ellipse;wh