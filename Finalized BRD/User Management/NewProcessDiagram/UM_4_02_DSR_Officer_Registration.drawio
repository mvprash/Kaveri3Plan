<mxfile host="app.diagrams.net" type="device"><diagram id="UM_4_02_DSR_Officer_Registration" name="UM_4_02_DSR_Officer_Registration"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1060" pageHeight="1890" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lane_adm" value="Authorised Administrator" style="swimlane;horizontal=1;html=1;startSize=60;whiteSpace=wrap;fillColor=#dae8fc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="90" width="260" height="1620" as="geometry"/></mxCell><mxCell id="lane_sys" value="Kaveri System" style="swimlane;horizontal=1;html=1;startSize=60;whiteSpace=wrap;fillColor=#d5e8d4;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="260" y="90" width="260" height="1620" as="geometry"/></mxCell><mxCell id="lane_off" value="DSR Officer" style="swimlane;horizontal=1;html=1;startSize=60;whiteSpace=wrap;fillColor=#fff2cc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="520" y="90" width="500" height="1620" as="geometry"/></mxCell><mxCell id="title" value="&lt;b style='font-size:20px'&gt;4.2 DSR Officer Registration&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;BRD User Management (Simplified) v1.8 — requirements UM-DSR-01 to 08&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="1020" height="70" as="geometry"/></mxCell><mxCell id="s" value="Start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="98" y="188" width="64" height="64" as="geometry"/></mxCell><mxCell id="d1" value="&lt;b&gt;1.&lt;/b&gt; Enter the officer's KGID and mobile number&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-DSR-01, 02&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="315" width="200" height="90" as="geometry"/></mxCell><mxCell id="d1d" value="Is the KGID unique?&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-DSR-02&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="445" width="200" height="110" as="geometry"/></mxCell><mxCell id="d2" value="&lt;b&gt;2.&lt;/b&gt; Verify the mobile number by OTP&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-DSR-02&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="595" width="200" height="90" as="geometry"/></mxCell><mxCell id="d3" value="&lt;b&gt;3.&lt;/b&gt; Record the officer's face or biometric details for sign-in&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-DSR-06&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="735" width="200" height="90" as="geometry"/></mxCell><mxCell id="d3d" value="Give a post now?&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-DSR-03&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="865" width="200" height="110" as="geometry"/></mxCell><mxCell id="d4" value="&lt;b&gt;4.&lt;/b&gt; Select one or more posts (only posts with a vacancy are shown)&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-DSR-03, 04&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="1015" width="200" height="90" as="geometry"/></mxCell><mxCell id="d5" value="&lt;b&gt;5.&lt;/b&gt; Create the officer (KGID is the Username) and send an SMS&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-DSR-02, 07&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="1155" width="200" height="90" as="geometry"/></mxCell><mxCell id="d5d" value="Post given?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="1285" width="200" height="110" as="geometry"/></mxCell><mxCell id="d6" value="&lt;b&gt;6.&lt;/b&gt; Can sign in with KGID, Captcha and face / biometric&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-DSR-06&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="550" y="1435" width="200" height="90" as="geometry"/></mxCell><mxCell id="d7" value="&lt;b&gt;7.&lt;/b&gt; Cannot sign in until a post is assigned (activity 4.8)&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-DSR-08&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="790" y="1435" width="200" height="90" as="geometry"/></mxCell><mxCell id="e" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="738" y="1588" width="64" height="64" as="geometry"/></mxCell><mxCell id="e_s_d1_16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_d1_d1d_17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="d1" target="d1d"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_d1d_d1_18" value="No — correct the KGID" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#b85450;fontColor=#b85450;exitX=0.5;exitY=0;entryX=1;entryY=0.5;" edge="1" parent="1" source="d1d" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_d1d_d2_19" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="d1d" target="d2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_d2_d3_20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="d2" target="d3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_d3_d3d_21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="d3" target="d3d"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_d3d_d4_22" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="d3d" target="d4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_d3d_d5_23" value="No — assign later" style="edgeStyl