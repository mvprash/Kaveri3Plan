<mxfile host="app.diagrams.net" type="device"><diagram id="UM_4_01_Citizen_Registration" name="UM_4_01_Citizen_Registration"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="800" pageHeight="2170" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lane_cit" value="Citizen" style="swimlane;horizontal=1;html=1;startSize=60;whiteSpace=wrap;fillColor=#dae8fc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="90" width="260" height="1900" as="geometry"/></mxCell><mxCell id="lane_sys" value="Kaveri System" style="swimlane;horizontal=1;html=1;startSize=60;whiteSpace=wrap;fillColor=#d5e8d4;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="260" y="90" width="260" height="1900" as="geometry"/></mxCell><mxCell id="title" value="&lt;b style='font-size:20px'&gt;4.1 Citizen Registration&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;BRD User Management (Simplified) v1.8 — requirements UM-CIT-01 to 07&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="760" height="70" as="geometry"/></mxCell><mxCell id="s" value="Start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="98" y="188" width="64" height="64" as="geometry"/></mxCell><mxCell id="c1" value="&lt;b&gt;1.&lt;/b&gt; Open Kaveri and choose Register (any time, no approval needed)&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-CIT-01&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="315" width="200" height="90" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;2.&lt;/b&gt; Choose a Username&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-CIT-02&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="455" width="200" height="90" as="geometry"/></mxCell><mxCell id="c2d" value="Is the Username free?&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-CIT-02, 06&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="585" width="200" height="110" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;3.&lt;/b&gt; Enter email and mobile number (no password, no security questions)&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-CIT-03, 05&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="735" width="200" height="90" as="geometry"/></mxCell><mxCell id="c3d" value="Is the email free?&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-CIT-03, 06&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="865" width="200" height="110" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;4.&lt;/b&gt; Send an OTP to the email and to the mobile&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-CIT-03&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="1015" width="200" height="90" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;5.&lt;/b&gt; Enter both OTPs&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-CIT-03&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="1155" width="200" height="90" as="geometry"/></mxCell><mxCell id="c5d" value="Both OTPs correct?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="1285" width="200" height="110" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;6.&lt;/b&gt; Create the account. The Username can never be changed&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-CIT-03, 07&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="1435" width="200" height="90" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;7.&lt;/b&gt; Sign in for the first time and complete Aadhaar e-KYC&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-CIT-04&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="1575" width="200" height="90" as="geometry"/></mxCell><mxCell id="c7d" value="e-KYC successful?&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-CIT-04&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="1705" width="200" height="110" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;8.&lt;/b&gt; Allow the citizen to use all services&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-CIT-04&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="1855" width="200" height="90" as="geometry"/></mxCell><mxCell id="e" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="98" y="1868" width="64" height="64" as="geometry"/></mxCell><mxCell id="e_s_c1_17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s" target="c1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_c1_c2_18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_c2_c2d_19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="c2" target="c2d"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_c2d_c2_20" value="No — taken; system suggests other names" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#b85450;fontColor=#b85450;exitX=1;exitY=0.5;entryX=1;entryY=0.25;" edge="1" parent="1" source="c2d" target="c2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="512" y="640"/><mxPoint x="512" y="477"/></Array></mxGeometry></mxCell><mxCell id="e_c2d_c3_21" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="c2d" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_c3_c3d_22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="c3" target="c3d"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_c3d_c3_23" value="No — already registered; enter another email" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#b85450;fontColor=#b85450;exitX=1;exitY=0.5;entryX=1;entryY=0.25;" edge="1" parent="1" source="c3d" target="c3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="512" y="920"/><mxPoint x="512" y="757"/></Array></mxGeometry></mxCell><mxCell id="e_c3d_c4_24" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c3d" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_c4_c5_25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_c5_c5d_26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="c5" target="c5d"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_c5d_c5_27" value="No — try again" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#b85450;fontColor=#b85450;exitX=1;exitY=0.5;entryX=1;entryY=0.25;" edge="1" parent="1" source="c5d" target="c5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="512" y="1340"/><mxPoint x="512" y="1177"/></Array></mxGeometry></mxCell><mxCell id="e_c5d_c6_28" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c5d" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_c6_c7_29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_c7_c7d_30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="c7" target="c7d"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_c7d_c7_31" value="No — only e-KYC is shown until it succeeds" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#b85450;fontColor=#b85450;exitX=1;exitY=0.5;entryX=1;entryY=0.25;" edge="1" parent="1" source="c7d" target="c7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="512" y="1760"/><mxPoint x="512" y="1597"/></Array></mxGeometry></mxCell><mxCell id="e_c7d_c8_32" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c7d" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_c8_e_33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c8" target="e"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="legend_t" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;align=left;" vertex="1" parent="1"><mxGeometry x="0" y="2020" width="120" height="24" as="geometry"/></mxCell><mxCell id="legend_0" value="Start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="2050" width="64" height="64" as="geometry"/></mxCell><mxCell id="legend_1" value="Step done by the person or system in that lane" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="84" y="2050" width="140" height="56" as="geometry"/></mxCell><mxCell id="legend_2" value="Check / choice" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="244" y="2050" width="140" height="56" as="geometry"/></mxCell><mxCell id="legend_3" value="Stopped / refused" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="404" y="2050" width="140" height="56" as="geometry"/></mxCell><mxCell id="legend_4" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="564" y="2050" width="64" height="64" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>