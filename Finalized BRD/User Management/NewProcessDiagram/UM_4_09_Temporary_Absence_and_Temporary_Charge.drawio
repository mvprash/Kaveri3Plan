<mxfile host="app.diagrams.net" type="device"><diagram id="UM_4_09_Temporary_Absence_and_Temporary_Charge" name="UM_4_09_Temporary_Absence_and_Temporary_Charge"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1080" pageHeight="1610" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lane_sup" value="Superior Officer" style="swimlane;horizontal=1;html=1;startSize=60;whiteSpace=wrap;fillColor=#dae8fc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="90" width="260" height="1340" as="geometry"/></mxCell><mxCell id="lane_sys" value="Kaveri System" style="swimlane;horizontal=1;html=1;startSize=60;whiteSpace=wrap;fillColor=#d5e8d4;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="260" y="90" width="260" height="1340" as="geometry"/></mxCell><mxCell id="lane_abs" value="Absent Officer" style="swimlane;horizontal=1;html=1;startSize=60;whiteSpace=wrap;fillColor=#fff2cc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="520" y="90" width="260" height="1340" as="geometry"/></mxCell><mxCell id="lane_cov" value="Covering Officer" style="swimlane;horizontal=1;html=1;startSize=60;whiteSpace=wrap;fillColor=#ffe6cc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="780" y="90" width="260" height="1340" as="geometry"/></mxCell><mxCell id="title" value="&lt;b style='font-size:20px'&gt;4.9 Temporary Absence and Temporary Charge&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;BRD User Management (Simplified) v1.8 — requirements UM-ABS-01 to 07&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="1040" height="70" as="geometry"/></mxCell><mxCell id="s" value="Start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="98" y="188" width="64" height="64" as="geometry"/></mxCell><mxCell id="b1" value="&lt;b&gt;1.&lt;/b&gt; Record Leave, OOD or Other absence with reason, dates and optional order&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-ABS-01, 02&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="315" width="200" height="90" as="geometry"/></mxCell><mxCell id="b2" value="&lt;b&gt;2.&lt;/b&gt; Block the officer from signing in. The post does not become vacant&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-ABS-03, 04&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="455" width="200" height="90" as="geometry"/></mxCell><mxCell id="b3" value="&lt;b&gt;3.&lt;/b&gt; Cannot sign in; message shows the absence type and end date&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-LOG-12&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="550" y="595" width="200" height="90" as="geometry"/></mxCell><mxCell id="b3d" value="Give temporary charge?&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-ABS-05&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="725" width="200" height="110" as="geometry"/></mxCell><mxCell id="b4" value="&lt;b&gt;4.&lt;/b&gt; Select another officer under the superior (may be at another office)&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-ABS-05&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="875" width="200" height="90" as="geometry"/></mxCell><mxCell id="b5" value="&lt;b&gt;5.&lt;/b&gt; Sees 'Temporary charge' at sign-in and does only that post's work&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-ABS-06&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="1015" width="200" height="90" as="geometry"/></mxCell><mxCell id="b6" value="&lt;b&gt;6.&lt;/b&gt; End the absence and charge after the to-date (or earlier if cancelled)&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-ABS-07&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="1155" width="200" height="90" as="geometry"/></mxCell><mxCell id="e" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="358" y="1308" width="64" height="64" as="geometry"/></mxCell><mxCell id="e_s_b1_14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s" target="b1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_b1_b2_15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_b2_b3_16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_b3_b3d_17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="b3" target="b3d"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_b3d_b4_18" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="b3d" target="b4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_b3d_b6_19" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b3d" target="b6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="14" y="780"/><mxPoint x="14" y="1200"/></Array></mxGeometry></mxCell><mxCell id="e_b4_b5_20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="b4" target="b5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_b5_b6_21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="b5" target="b6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_b6_e_22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="b6" target="e"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="legend_t" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;align=left;" vertex="1" parent="1"><mxGeometry x="0" y="1460" width="120" height="24" as="geometry"/></mxCell><mxCell id="legend_0" value="Start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="1490" width="64" height="64" as="geometry"/></mxCell><mxCell id="legend_1" value="Step done by the person or system in that lane" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="84" y="1490" width="140" height="56" as="geometry"/></mxCell><mxCell id="legend_2" value="Check / choice" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="244" y="1490" width="140" height="56" as="geometry"/></mxCell><mxCell id="legend_3" value="Stopped / refused" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="404" y="1490" width="140" height="56" as="geometry"/></mxCell><mxCell id="legend_4" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="564" y="1490" width="64" height="64" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>