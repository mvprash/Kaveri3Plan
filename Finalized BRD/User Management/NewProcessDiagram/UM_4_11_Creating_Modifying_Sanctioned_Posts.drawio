<mxfile host="app.diagrams.net" type="device"><diagram id="UM_4_11_Creating_Modifying_Sanctioned_Posts" name="UM_4_11_Creating_Modifying_Sanctioned_Posts"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="800" pageHeight="1470" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lane_adm" value="Authorised Administrator" style="swimlane;horizontal=1;html=1;startSize=60;whiteSpace=wrap;fillColor=#dae8fc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="90" width="260" height="1200" as="geometry"/></mxCell><mxCell id="lane_sys" value="Kaveri System" style="swimlane;horizontal=1;html=1;startSize=60;whiteSpace=wrap;fillColor=#d5e8d4;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="260" y="90" width="260" height="1200" as="geometry"/></mxCell><mxCell id="title" value="&lt;b style='font-size:20px'&gt;4.11 Creating / Modifying Sanctioned Posts for Each Office&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;BRD User Management (Simplified) v1.8 — requirements UM-SAN-01 to 05&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="760" height="70" as="geometry"/></mxCell><mxCell id="s" value="Start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="98" y="188" width="64" height="64" as="geometry"/></mxCell><mxCell id="p1" value="&lt;b&gt;1.&lt;/b&gt; Add or change a post and link it to a division&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-SAN-01&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="315" width="200" height="90" as="geometry"/></mxCell><mxCell id="p2" value="&lt;b&gt;2.&lt;/b&gt; Set which types of office the post can exist in&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-SAN-02&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="455" width="200" height="90" as="geometry"/></mxCell><mxCell id="p3" value="&lt;b&gt;3.&lt;/b&gt; Set the sanctioned strength of the post in each office&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-SAN-03&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="595" width="200" height="90" as="geometry"/></mxCell><mxCell id="p4" value="&lt;b&gt;4.&lt;/b&gt; Save and record the change&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-SAN-03&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="735" width="200" height="90" as="geometry"/></mxCell><mxCell id="p5" value="&lt;b&gt;5.&lt;/b&gt; Show sanctioned, occupied and vacant counts for every post in every office&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-SAN-04&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="875" width="200" height="90" as="geometry"/></mxCell><mxCell id="p6" value="&lt;b&gt;6.&lt;/b&gt; Allow officers to be placed only where there is a vacancy&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-SAN-05&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="1015" width="200" height="90" as="geometry"/></mxCell><mxCell id="e" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometr