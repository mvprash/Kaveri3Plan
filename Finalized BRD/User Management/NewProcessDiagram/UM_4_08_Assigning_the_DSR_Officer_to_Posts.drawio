<mxfile host="app.diagrams.net" type="device"><diagram id="UM_4_08_Assigning_the_DSR_Officer_to_Posts" name="UM_4_08_Assigning_the_DSR_Officer_to_Posts"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1780" pageHeight="1610" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lane_igr" value="IGR Office&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px'&gt;Authorised user&lt;/span&gt;" style="swimlane;horizontal=1;html=1;startSize=60;whiteSpace=wrap;fillColor=#dae8fc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="90" width="240" height="1340" as="geometry"/></mxCell><mxCell id="lane_sup" value="Superior Officer" style="swimlane;horizontal=1;html=1;startSize=60;whiteSpace=wrap;fillColor=#d5e8d4;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="240" y="90" width="500" height="1340" as="geometry"/></mxCell><mxCell id="lane_sys" value="Kaveri System" style="swimlane;horizontal=1;html=1;startSize=60;whiteSpace=wrap;fillColor=#fff2cc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="740" y="90" width="500" height="1340" as="geometry"/></mxCell><mxCell id="lane_off" value="DSR Officer" style="swimlane;horizontal=1;html=1;startSize=60;whiteSpace=wrap;fillColor=#ffe6cc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1240" y="90" width="500" height="1340" as="geometry"/></mxCell><mxCell id="title" value="&lt;b style='font-size:20px'&gt;4.8 Assigning the DSR Officer to Posts&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;BRD User Management (Simplified) v1.8 — requirements UM-ASG-01 to 12&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="1740" height="70" as="geometry"/></mxCell><mxCell id="s" value="Start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="88" y="188" width="64" height="64" as="geometry"/></mxCell><mxCell id="g1" value="&lt;b&gt;1.&lt;/b&gt; Upload the movement order for the officer&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-ASG-02&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="315" width="200" height="90" as="geometry"/></mxCell><mxCell id="g2" value="&lt;b&gt;2.&lt;/b&gt; Select the officer (only offices and posts directly under the superior)&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-ASG-03&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="390" y="455" width="200" height="90" as="geometry"/></mxCell><mxCell id="g2d" value="Select the process&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-ASG-01&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="390" y="585" width="200" height="110" as="geometry"/></mxCell><mxCell id="r1" value="&lt;b&gt;3.&lt;/b&gt; &lt;b&gt;Transfer Out / Relieving:&lt;/b&gt; select the post(s); enter Relieving Date, Order and Reason&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-ASG-08&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="270" y="735" width="200" height="90" as="geometry"/></mxCell><mxCell id="r2" value="&lt;b&gt;4.&lt;/b&gt; Officer keeps the post until the end of the Relieving Date&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-ASG-09&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="770" y="875" width="200" height="90" as="geometry"/></mxCell><mxCell id="r3" value="&lt;b&gt;5.&lt;/b&gt; After midnight, remove the officer from the post, update vacancy and end any open session&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-ASG-10, 11&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="770" y="1015" width="200" height="90" as="geometry"/></mxCell><mxCell id="r4" value="&lt;b&gt;6.&lt;/b&gt; If no post is left, cannot sign in until a new post is given&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-ASG-12&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1270" y="1155" width="200" height="90" as="geometry"/></mxCell><mxCell id="t1" value="&lt;b&gt;3.&lt;/b&gt; &lt;b&gt;Transfer In:&lt;/b&gt; select a post and enter the Transfer / Reporting Order&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-ASG-05&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="510" y="735" width="200" height="90" as="geometry"/></mxCell><mxCell id="t1d" value="Does the post have a vacancy?&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-ASG-04, 07&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1010" y="865" width="200" height="110" as="geometry"/></mxCell><mxCell id="t2" value="&lt;b&gt;4.&lt;/b&gt; Place the officer in the post now and update the vacancy count&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-ASG-06&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1010" y="1015" width="200" height="90" as="geometry"/></mxCell><mxCell id="t3" value="&lt;b&gt;5.&lt;/b&gt; Sees the new post at the next sign-in&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-ASG-06&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1510" y="1155" width="200" height="90" as="geometry"/></mxCell><mxCell id="e" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1458" y="1308" width="64" height="64" as="geometry"/></mxCell><mxCell id="e_s_g1_18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s" target="g1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_g1_g2_19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="g1" target="g2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_g2_g2d_20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="g2" target="g2d"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_g2d_r1_21" value="Transfer Out / Relieving" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="g2d" target="r1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_g2d_t1_22" value="Transfer In" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="g2d" target="t1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_r1_r2_23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="r1" target="r2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_r2_r3_24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="r2" target="r3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_r3_r4_25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="r3" target="r4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_t1_t1d_26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="t1" target="t1d"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="610" y="842"/><mxPoint x="1110" y="842"/></Array></mxGeometry></mxCell><mxCell id="e_t1d_t1_27" value="No — post is full; blocked" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#b85450;fontColor=#b85450;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="t1d" target="t1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1226" y="920"/><mxPoint x="1226" y="780"/></Array></mxGeometry></mxCell><mxCell id="e_t1d_t2_28" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="t1d" target="t2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_t2_t3_29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="t2" target="t3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1110" y="1128"/><mxPoint x="1610" y="1128"/></Array></mxGeometry></mxCell><mxCell id="e_r4_e_30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="r4" target="e"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_t3_e_31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="t3" target="e"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="legend_t" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;align=left;" vertex="1" parent="1"><mxGeometry x="0" y="1460" width="120" height="24" as="geometry"/></mxCell><mxCell id="legend_0" value="Start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="1490" width="64" height="64" as="geometry"/></mxCell><mxCell id="legend_1" value="Step done by the person or system in that lane" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="84" y="1490" width="140" height="56" as="geometry"/></mxCell><mxCell id="legend_2" value="Check / choice" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="244" y="1490" width="140" height="56" as="geometry"/></mxCell><mxCell id="legend_3" value="Stopped / refused" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="404" y="1490" width="140" height="56" as="geometry"/></mxCell><mxCell id="legend_4" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="564" y="1490" width="64" height="64" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>