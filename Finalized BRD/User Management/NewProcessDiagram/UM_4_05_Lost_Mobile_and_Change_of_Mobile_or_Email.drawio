<mxfile host="app.diagrams.net" type="device"><diagram id="UM_4_05_Lost_Mobile_and_Change_of_Mobile_or_Email" name="UM_4_05_Lost_Mobile_and_Change_of_Mobile_or_Email"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1080" pageHeight="1750" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lane_cit" value="Citizen&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px'&gt;Lost mobile&lt;/span&gt;" style="swimlane;horizontal=1;html=1;startSize=60;whiteSpace=wrap;fillColor=#dae8fc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="90" width="260" height="1480" as="geometry"/></mxCell><mxCell id="lane_sys" value="Kaveri System" style="swimlane;horizontal=1;html=1;startSize=60;whiteSpace=wrap;fillColor=#d5e8d4;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="260" y="90" width="260" height="1480" as="geometry"/></mxCell><mxCell id="lane_usr" value="Citizen or DSR Officer&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px'&gt;After sign-in&lt;/span&gt;" style="swimlane;horizontal=1;html=1;startSize=60;whiteSpace=wrap;fillColor=#fff2cc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="520" y="90" width="260" height="1480" as="geometry"/></mxCell><mxCell id="lane_adm" value="Authorised Administrator&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px'&gt;For Other Department users&lt;/span&gt;" style="swimlane;horizontal=1;html=1;startSize=60;whiteSpace=wrap;fillColor=#ffe6cc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="780" y="90" width="260" height="1480" as="geometry"/></mxCell><mxCell id="title" value="&lt;b style='font-size:20px'&gt;4.5 Lost Mobile and Change of Mobile or Email&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;BRD User Management (Simplified) v1.8 — requirements UM-MOB-01 to 06&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="1040" height="70" as="geometry"/></mxCell><mxCell id="s" value="Start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="358" y="188" width="64" height="64" as="geometry"/></mxCell><mxCell id="m0" value="What is needed?&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-MOB-06&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="305" width="200" height="110" as="geometry"/></mxCell><mxCell id="m1" value="&lt;b&gt;1.&lt;/b&gt; Enter Username and Captcha&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-MOB-01&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="455" width="200" height="90" as="geometry"/></mxCell><mxCell id="m2" value="&lt;b&gt;2.&lt;/b&gt; Complete Aadhaar e-KYC&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-MOB-01&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="595" width="200" height="90" as="geometry"/></mxCell><mxCell id="m3" value="&lt;b&gt;3.&lt;/b&gt; Send a PIN to the registered email&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-MOB-01&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="735" width="200" height="90" as="geometry"/></mxCell><mxCell id="m4" value="&lt;b&gt;4.&lt;/b&gt; Enter the PIN and the new mobile number&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-MOB-01&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="875" width="200" height="90" as="geometry"/></mxCell><mxCell id="m5" value="&lt;b&gt;5.&lt;/b&gt; Send an OTP to the new mobile&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-MOB-01&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="1015" width="200" height="90" as="geometry"/></mxCell><mxCell id="m6" value="&lt;b&gt;6.&lt;/b&gt; Enter the OTP (repeated failures lock the reset for 30 minutes)&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-MOB-02&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="1155" width="200" height="90" as="geometry"/></mxCell><mxCell id="m7" value="&lt;b&gt;7.&lt;/b&gt; Update the mobile and inform the citizen by email&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-MOB-01&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="1295" width="200" height="90" as="geometry"/></mxCell><mxCell id="u1" value="&lt;b&gt;1.&lt;/b&gt; Enter the new mobile (citizens can also change email)&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-MOB-03, 04&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="550" y="455" width="200" height="90" as="geometry"/></mxCell><mxCell id="u2" value="&lt;b&gt;2.&lt;/b&gt; Enter the OTP sent to the new mobile or email&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-MOB-03, 04&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="550" y="595" width="200" height="90" as="geometry"/></mxCell><mxCell id="u3" value="&lt;b&gt;3.&lt;/b&gt; Mobile or email is updated&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-MOB-03, 04&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="550" y="735" width="200" height="90" as="geometry"/></mxCell><mxCell id="a1" value="&lt;b&gt;1.&lt;/b&gt; Change the mobile or email and enter a reason&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-MOB-05&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="455" width="200" height="90" as="geometry"/></mxCell><mxCell id="a2" value="&lt;b&gt;2.&lt;/b&gt; Change is saved and recorded&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-MOB-05&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="595" width="200" height="90" as="geometry"/></mxCell><mxCell id="e" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="358" y="1448" width="64" height="64" as="geometry"/></mxCell><mxCell id="e_s_m0_20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s" target="m0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_m0_m1_21" value="Citizen lost mobile" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="m0" target="m1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e