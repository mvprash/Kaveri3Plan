<mxfile host="app.diagrams.net" type="device"><diagram id="UM_4_12_Creating_Managing_Reporting_Hierarchies" name="UM_4_12_Creating_Managing_Reporting_Hierarchies"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="800" pageHeight="1330" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lane_adm" value="Authorised Administrator" style="swimlane;horizontal=1;html=1;startSize=60;whiteSpace=wrap;fillColor=#dae8fc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="90" width="260" height="1060" as="geometry"/></mxCell><mxCell id="lane_sys" value="Kaveri System" style="swimlane;horizontal=1;html=1;startSize=60;whiteSpace=wrap;fillColor=#d5e8d4;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="260" y="90" width="260" height="1060" as="geometry"/></mxCell><mxCell id="title" value="&lt;b style='font-size:20px'&gt;4.12 Creating / Managing Reporting Hierarchies&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;BRD User Management (Simplified) v1.8 — requirements UM-HIE-01 to 04&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="760" height="70" as="geometry"/></mxCell><mxCell id="s" value="Start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="98" y="188" width="64" height="64" as="geometry"/></mxCell><mxCell id="h1" value="&lt;b&gt;1.&lt;/b&gt; Add or change an office: code, name, type and parent office&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-HIE-01&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="315" width="200" height="90" as="geometry"/></mxCell><mxCell id="h2" value="&lt;b&gt;2.&lt;/b&gt; Set the post that each post reports to (one parent post)&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-HIE-02&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="455" width="200" height="90" as="geometry"/></mxCell><mxCell id="h3" value="&lt;b&gt;3.&lt;/b&gt; Reorder, enable or disable offices and hierarchy entries when needed&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-HIE-03&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="595" width="200" height="90" as="geometry"/></mxCell><mxCell id="h4" value="&lt;b&gt;4.&lt;/b&gt; Save and record the change&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-HIE-03&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="735" width="200" height="90" as="geometry"/></mxCell><mxCell id="h5" value="&lt;b&gt;5.&lt;/b&gt; Use the hierarchies to decide what each superior can see and do&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-HIE-04&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="875" width="200" height="90" as="geometry"/></mxCell><mxCell id="e" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="358" y="1028" width="64" height="64" as="geometry"/></mxCell><mxCell id="e_s_h1_10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s" target="h1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_h1_h2_11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="h1" target="h2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_h2_h3_12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="h2" target="h3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_h3_h4_13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="h3" target="h4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_h4_h5_14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="h4" target="h5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_h5_e_15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="h5" target="e"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="legend_t" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;align=left;" vertex="1" parent="1"><mxGeometry x="0" y="1180" width="120" height="24" as="geometry"/></mxCell><mxCell id="legend_0" value="Start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;