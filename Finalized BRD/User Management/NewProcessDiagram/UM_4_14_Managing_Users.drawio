<mxfile host="app.diagrams.net" type="device"><diagram id="UM_4_14_Managing_Users" name="UM_4_14_Managing_Users"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="820" pageHeight="1190" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lane_adm" value="Authorised Administrator" style="swimlane;horizontal=1;html=1;startSize=60;whiteSpace=wrap;fillColor=#dae8fc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="90" width="260" height="920" as="geometry"/></mxCell><mxCell id="lane_sys" value="Kaveri System" style="swimlane;horizontal=1;html=1;startSize=60;whiteSpace=wrap;fillColor=#d5e8d4;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="260" y="90" width="260" height="920" as="geometry"/></mxCell><mxCell id="lane_usr" value="User" style="swimlane;horizontal=1;html=1;startSize=60;whiteSpace=wrap;fillColor=#fff2cc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="520" y="90" width="260" height="920" as="geometry"/></mxCell><mxCell id="title" value="&lt;b style='font-size:20px'&gt;4.14 Managing Users&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;BRD User Management (Simplified) v1.5 — requirements UM-USR-01 to 06&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="780" height="70" as="geometry"/></mxCell><mxCell id="s" value="Start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="98" y="188" width="64" height="64" as="geometry"/></mxCell><mxCell id="u1" value="&lt;b&gt;1.&lt;/b&gt; Search for the user by Username / KGID, type, role, office, division or status&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-USR-02&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="315" width="200" height="90" as="geometry"/></mxCell><mxCell id="u2" value="&lt;b&gt;2.&lt;/b&gt; Change, suspend or deactivate the user, or correct the Username (with a reason where needed)&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-USR-01, 03&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="455" width="200" height="90" as="geometry"/></mxCell><mxCell id="u3" value="&lt;b&gt;3.&lt;/b&gt; Save at once (no second approval) and record the action&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-USR-05, 06&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="595" width="200" height="90" as="geometry"/></mxCell><mxCell id="u4" value="&lt;b&gt;4.&lt;/b&gt; Informed by SMS / email when the account is created, suspended or deactivated&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-USR-04&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="550" y="735" width="200" height="90" as="geometry"/></mxCell><mxCell id="e" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="618" y="888" width="64" height="64" as="geometry"/></mxCell><mxCell id="e_s_u1_10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s" target="u1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_u1_u2_11" value="" style="edgeStyle=ortho