<mxfile host="app.diagrams.net" type="device"><diagram id="UM_4_04_User_Logins" name="UM_4_04_User_Logins"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1060" pageHeight="1890" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lane_dsr" value="DSR Officer" style="swimlane;horizontal=1;html=1;startSize=60;whiteSpace=wrap;fillColor=#dae8fc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="90" width="260" height="1620" as="geometry"/></mxCell><mxCell id="lane_otp" value="Citizen / Other Department User" style="swimlane;horizontal=1;html=1;startSize=60;whiteSpace=wrap;fillColor=#d5e8d4;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="260" y="90" width="260" height="1620" as="geometry"/></mxCell><mxCell id="lane_sys" value="Kaveri System" style="swimlane;horizontal=1;html=1;startSize=60;whiteSpace=wrap;fillColor=#fff2cc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="520" y="90" width="500" height="1620" as="geometry"/></mxCell><mxCell id="title" value="&lt;b style='font-size:20px'&gt;4.4 User Logins&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;BRD User Management (Simplified) v1.5 — requirements UM-LOG-01 to 12&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="1020" height="70" as="geometry"/></mxCell><mxCell id="s" value="Start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="618" y="188" width="64" height="64" as="geometry"/></mxCell><mxCell id="l0" value="Which type of user? (no passwords for anyone)&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-LOG-01&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="550" y="305" width="200" height="110" as="geometry"/></mxCell><mxCell id="l1" value="&lt;b&gt;1.&lt;/b&gt; Enter Username and Captcha&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-LOG-02&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="455" width="200" height="90" as="geometry"/></mxCell><mxCell id="l2" value="&lt;b&gt;1.&lt;/b&gt; Enter KGID and Captcha&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-LOG-03&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="455" width="200" height="90" as="geometry"/></mxCell><mxCell id="l3" value="&lt;b&gt;2.&lt;/b&gt; Send a 6-digit OTP to the registered mobile (valid 5 minutes)&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-LOG-02, 04&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="550" y="595" width="200" height="90" as="geometry"/></mxCell><mxCell id="l4" value="&lt;b&gt;3.&lt;/b&gt; Enter the OTP&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-LOG-04&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="735" width="200" height="90" as="geometry"/></mxCell><mxCell id="l5" value="&lt;b&gt;2.&lt;/b&gt; Give face or biometric check (no OTP)&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-LOG-03&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="735" width="200" height="90" as="geometry"/></mxCell><mxCell id="l6" value="Check passed and not on leave?&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-LOG-05, 12&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="550" y="865" width="200" height="110" as="geometry"/></mxCell><mxCell id="rej" value="Refuse sign-in and show the reason. After 5 failures, lock for 15 minutes&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-LOG-05, 12&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="795" y="875" width="200" height="90" as="geometry"/></mxCell><mxCell id="ex" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="863" y="1028" width="64" height="64" as="geometry"/></mxCell><mxCell id="l7" value="DSR Officer with more than one post?&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-LOG-09&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="550" y="1005" width="200" height="110" as="geometry"/></mxCell><mxCell id="l8" value="&lt;b&gt;4.&lt;/b&gt; Select one post&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-LOG-09&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="1155" width="200" height="90" as="geometry"/></mxCell><mxCell id="l9" value="&lt;b&gt;5.&lt;/b&gt; Open the home screen. Header shows post, role and office; only that post's work is allowed&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-LOG-10, 11&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="550" y="1295" width="200" height="90" as="geometry"/></mxCell><mxCell id="l10" value="&lt;b&gt;6.&lt;/b&gt; Sign out after 10 minutes idle or 4 hours. A new sign-in closes the old one&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;UM-LOG-06, 07, 08&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="550" y="1435" width="200" height="90" as="geometry"/></mxCell><mxCell id="e" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="618" y="1588" width="64" height="64" as="geometry"/></mxCell><mxCell id="e_s_l0_19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s" target="l0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_l0_l1_20" value="Citizen / Other Department user" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="l0" target="l1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_l0_l2_21" value="DSR Officer" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="l0" target="l2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_l1_l3_22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="l1" target="l3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_l3_l4_23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="l3" target="l4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_l2_l5_24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="l2" target="l5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_l4_l6_25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="l4" target="l6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_l5_l6_26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="l5" target="l6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_l6_rej_27" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#b85450;fontColor=#b85450;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="l6" target="rej"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_rej_ex_28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="rej" target="ex"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_l6_l7_29" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="l6" target="l7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_l7_l8_30" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="l7" target="l8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_l7_l9_31" value="No — one post, selected automatically" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="l7" target="l9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_l8_l9_32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="l8" target="l9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_l9_l10_33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="l9" target="l10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_l10_e_34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="l10" target="e"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="legend_t" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;align=left;" vertex="1" parent="1"><mxGeometry x="0" y="1740" width="120" height="24" as="geometry"/></mxCell><mxCell id="legend_0" value="Start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="1770" width="64" height="64" as="geometry"/></mxCell><mxCell id="legend_1" value="Step done by the person or system in that lane" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="84" y="1770" width="140" height="56" as="geometry"/></mxCell><mxCell id="legend_2" value="Check / choice" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="244" y="1770" width="140" height="56" as="geometry"/></mxCell><mxCell id="legend_3" value="Stopped / refused" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="404" y="1770" width="140" height="56" as="geometry"/></mxCell><mxCell id="legend_4" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="564" y="1770" width="64" height="64" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>