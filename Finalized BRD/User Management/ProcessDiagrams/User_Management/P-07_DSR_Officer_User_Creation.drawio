        <mxCell id="s1" parent="1" vertex="1" value="&lt;font color=&quot;#C77F26&quot;&gt;&lt;b&gt;ADMIN&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Open User Management → Add DSR Department User&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;&lt;i&gt;Authorised admin role only&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=13;fillColor=#FCEFDA;strokeColor=#C77F26;"><mxGeometry x="370.0" y="192.0" width="300.0" height="100.0" as="geometry"/></mxCell>
