        <mxCell id="s2" parent="1" vertex="1" value="&lt;font color=&quot;#C77F26&quot;&gt;&lt;b&gt;ADMIN&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Enter KGID — this becomes the Username&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;&lt;i&gt;Validated for presence + uniqueness&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=13;fillColor=#FCEFDA;strokeColor=#C77F26;"><mxGeometry x="370.0" y="338.0" width="300.0" height="84.5" as="geometry"/></mxCell>
