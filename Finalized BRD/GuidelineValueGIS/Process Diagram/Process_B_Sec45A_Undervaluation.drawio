<mxfile host="app.diagrams.net" type="device"><diagram id="Process B - Sec 45-A Undervaluation" name="Process B - Sec 45-A Undervaluation"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1540" pageHeight="2614" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lane_pty" value="Party / Presentant&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px'&gt;Person liable to pay duty&lt;/span&gt;" style="swimlane;horizontal=1;html=1;startSize=64;whiteSpace=wrap;fillColor=#dae8fc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="90" width="250" height="2334" as="geometry"/></mxCell><mxCell id="lane_sr" value="Sub-Registrar (SR)&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px'&gt;Registering officer&lt;/span&gt;" style="swimlane;horizontal=1;html=1;startSize=64;whiteSpace=wrap;fillColor=#d5e8d4;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="250" y="90" width="480" height="2334" as="geometry"/></mxCell><mxCell id="lane_dc" value="Deputy Commissioner&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px'&gt;(District Registrar where notified)&lt;/span&gt;" style="swimlane;horizontal=1;html=1;startSize=64;whiteSpace=wrap;fillColor=#fff2cc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="730" y="90" width="260" height="2334" as="geometry"/></mxCell><mxCell id="lane_app" value="Appellate Authority&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px'&gt;Regional Commissioner&lt;/span&gt;" style="swimlane;horizontal=1;html=1;startSize=64;whiteSpace=wrap;fillColor=#ffe6cc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="990" y="90" width="250" height="2334" as="geometry"/></mxCell><mxCell id="lane_sys" value="Kaveri System" style="swimlane;horizontal=1;html=1;startSize=64;whiteSpace=wrap;fillColor=#f8cecc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1240" y="90" width="260" height="2334" as="geometry"/></mxCell><mxCell id="title" value="&lt;b style='font-size:20px'&gt;Process B — Undervaluation Reference under Section 45-A&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;Karnataka Stamp Act, 1957 Sec. 45-A(1)–(5); Karnataka Stamp (Prevention of Undervaluation of Instruments) Rules, 1977 — BRD Guideline Value &amp; GIS Valuation v1.0&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="1500" height="70" as="geometry"/></mxCell><mxCell id="b_start" value="Start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="335" y="194" width="70" height="70" as="geometry"/></mxCell><mxCell id="b1" value="&lt;b&gt;1.&lt;/b&gt; Arrive at the estimated market value (CVC guidelines or otherwise) and record reasons&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Sec. 45-A(1)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="270" y="329" width="200" height="100" as="geometry"/></mxCell><mxCell id="b2" value="&lt;b&gt;2.&lt;/b&gt; Communicate estimated value and extra duty to the parties (SMS / e-mail / portal)&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Sec. 45-A(1)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1270" y="479" width="200" height="100" as="geometry"/></mxCell><mxCell id="b3" value="&lt;b&gt;3.&lt;/b&gt; Pay duty on the SR's estimated value?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="615" width="210" height="128" as="geometry"/></mxCell><mxCell id="b3y" value="Collect extra duty; continue registration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="510" y="629" width="200" height="100" as="geometry"/></mxCell><mxCell id="b_end1" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="575" y="794" width="70" height="70" as="geometry"/></mxCell><mxCell id="b4" value="&lt;b&gt;4.&lt;/b&gt; Keep registration pending; prepare Form I and refer to the DC with a copy of the instrument&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Sec. 45-A(1); 1977 Rules&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="270" y="779" width="200" height="100" as="geometry"/></mxCell><mxCell id="s_start" value="Start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="825" y="644" width="70" height="70" as="geometry"/></mxCell><mxCell id="s1" value="Suo motu: call for a registered instrument within 2 years of registration&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Sec. 45-A(3)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="779" width="200" height="100" as="geometry"/></mxCell><mxCell id="b5" value="&lt;b&gt;5.&lt;/b&gt; Issue notice, give the parties a hearing and hold the enquiry&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Sec. 45-A(2); 1977 Rules&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="929" width="200" height="100" as="geometry"/></mxCell><mxCell id="b6" value="&lt;b&gt;6.&lt;/b&gt; Order market value and duty payable (as far as may be within 90 days)&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Sec. 45-A(2)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="1079" width="200" height="100" as="geometry"/></mxCell><mxCell id="b7" value="&lt;b&gt;7.&lt;/b&gt; Send order to the party and a copy to the SR; lock adjudicated value as the market value&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Sec. 45-A(4)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1270" y="1229" width="200" height="100" as="geometry"/></mxCell><mxCell id="b8" value="&lt;b&gt;8.&lt;/b&gt; Appeal against the order?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="1365" width="210" height="128" as="geometry"/></mxCell><mxCell id="b9" value="&lt;b&gt;9.&lt;/b&gt; Deposit 50% of the duty difference and file the appeal&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Sec. 45-A(5)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="25" y="1529" width="200" height="100" as="geometry"/></mxCell><mxCell id="b10" value="&lt;b&gt;10.&lt;/b&gt; Hear and decide the appeal&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Sec. 45-A(5)&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1010" y="1665" width="210" height="128" as="geometry"/></mxCell><mxCell id="b10r" value="Remand: DC determines value again" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="1679" width="200" height="100" as="geometry"/></mxCell><mxCell id="b11" value="&lt;b&gt;11.&lt;/b&gt; Calculate duty difference + 12% p.a. interest if paid late; refund deposit if duty sufficient&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Sec. 45-A(2), (5)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1270" y="1829" width="200" height="100" as="geometry"/></mxCell><mxCell id="b12" value="&lt;b&gt;12.&lt;/b&gt; Pay the duty difference (and interest, if any)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="25" y="1979" width="200" height="100" as="geometry"/></mxCell><mxCell id="b13" value="&lt;b&gt;13.&lt;/b&gt; Release the pending document and complete registration (or close suo motu case)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="270" y="2129" width="200" height="100" as="geometry"/></mxCell><mxCell id="b_end" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="335" y="2294" width="70" height="70" as="geometry"/></mxCell><mxCell id="e_b_start_b1_26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b_start" target="b1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_b1_b2_27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_b2_b3_28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_b3_b3y_29" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b3" target="b3y"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_b3y_b_end1_30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b3y" target="b_end1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_b3_b4_31" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_b4_b5_32" value="Reference" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="b4" target="b5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_s_start_s1_33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s_start" target="s1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_s1_b5_34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s1" target="b5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_b5_b6_35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b5" target="b6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_b6_b7_36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="b6" target="b7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_b7_b8_37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="b7" target="b8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_b8_b9_38" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b8" target="b9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_b9_b10_39" value="Appeal" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="b9" target="b10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_b10_b10r_40" value="Remand" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#b85450;fontColor=#b85450;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="b10" target="b10r"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_b10r_b6_41" value="Fresh order" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#b85450;fontColor=#b85450;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b10r" target="b6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="746" y="1729"/><mxPoint x="746" y="1129"/></Array></mxGeometry></mxCell><mxCell id="e_b10_b11_42" value="Value decided" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="b10" target="b11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_b8_b11_43" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b8" target="b11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="16" y="1429"/><mxPoint x="16" y="1879"/></Array></mxGeometry></mxCell><mxCell id="e_b11_b12_44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="b11" target="b12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_b12_b13_45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="b12" target="b13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_b13_b_end_46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b13" target="b_end"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="legend_t" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;align=left;" vertex="1" parent="1"><mxGeometry x="0" y="2454" width="120" height="24" as="geometry"/></mxCell><mxCell id="legend_0" value="Start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="2484" width="70" height="70" as="geometry"/></mxCell><mxCell id="legend_1" value="Step done by the actor in that lane" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="94" y="2484" width="160" height="56" as="geometry"/></mxCell><mxCell id="legend_2" value="Decision / check" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="278" y="2484" width="160" height="56" as="geometry"/></mxCell><mxCell id="legend_3" value="Exception / manual path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="462" y="2484" width="160" height="56" as="geometry"/></mxCell><mxCell id="legend_4" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="646" y="2484" width="70" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>