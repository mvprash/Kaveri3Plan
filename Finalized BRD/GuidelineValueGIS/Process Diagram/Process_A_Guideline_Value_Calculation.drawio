nd&lt;/b&gt;" style="text;html=1;align=left;" vertex="1" parent="1"><mxGeometry x="0" y="2454" width="120" height="24" as="geometry"/></mxCell><mxCell id="legend_0" value="Start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="2484" width="70" height="70" as="geometry"/></mxCell><mxCell id="legend_1" value="Step done by the actor in that lane" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="94" y="2484" width="160" height="56" as="geometry"/></mxCell><mxCell id="legend_2" value="Decision / check" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="278" y="2484" width="160" height="56" as="geometry"/></mxCell><mxCell id="legend_3" value="Hand-off to another process" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="462" y="2484" width="160" height="56" as="geometry"/></mxCell><mxCell id="legend_4" value="Exception / manual path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="646" y="2484" width="160" height="56" as="geometry"/></mxCell><mxCell id="legend_5" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="830" y="2484" width="70" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>