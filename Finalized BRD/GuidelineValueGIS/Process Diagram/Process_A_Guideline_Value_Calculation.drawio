<mxfile host="app.diagrams.net" type="device"><diagram id="Process A - Guideline Value Calculation" name="Process A - Guideline Value Calculation"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="2614" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lane_cit" value="Citizen / Presentant&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px'&gt;or DEO at SRO (assisted)&lt;/span&gt;" style="swimlane;horizontal=1;html=1;startSize=64;whiteSpace=wrap;fillColor=#dae8fc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="90" width="470" height="2334" as="geometry"/></mxCell><mxCell id="lane_sys" value="Kaveri System&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px'&gt;Valuation engine + CVC Active rates&lt;/span&gt;" style="swimlane;horizontal=1;html=1;startSize=64;whiteSpace=wrap;fillColor=#d5e8d4;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="90" width="270" height="2334" as="geometry"/></mxCell><mxCell id="lane_gis" value="KSRSAC GIS&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px'&gt;Cadastral, boundary and road layers&lt;/span&gt;" style="swimlane;horizontal=1;html=1;startSize=64;whiteSpace=wrap;fillColor=#fff2cc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="740" y="90" width="250" height="2334" as="geometry"/></mxCell><mxCell id="lane_sr" value="Sub-Registrar (SR)" style="swimlane;horizontal=1;html=1;startSize=64;whiteSpace=wrap;fillColor=#ffe6cc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="990" y="90" width="470" height="2334" as="geometry"/></mxCell><mxCell id="title" value="&lt;b style='font-size:20px'&gt;Process A — Guideline Value Calculation with GIS Valuation&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;Karnataka Stamp Act, 1957 Secs. 2(mm), 3, 45-A, 45-B; Registration Rules 13–15 — BRD Guideline Value &amp; GIS Valuation v1.0&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="1460" height="70" as="geometry"/></mxCell><mxCell id="a_start" value="Start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="95" y="194" width="70" height="70" as="geometry"/></mxCell><mxCell id="a1" value="&lt;b&gt;1.&lt;/b&gt; Select district, taluk / town, hobli / ward and village for the property&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Reg. Rule 13&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="329" width="200" height="100" as="geometry"/></mxCell><mxCell id="a2" value="&lt;b&gt;2.&lt;/b&gt; Enter survey no. + Pot Hissa / city survey, or khata / ULPIN, or pick the property on the map&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Reg. Rule 15&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="479" width="200" height="100" as="geometry"/></mxCell><mxCell id="a3" value="&lt;b&gt;3.&lt;/b&gt; Find the parcel; return boundary (polygon), centre point and nearest road&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;KSRSAC&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="765" y="629" width="200" height="100" as="geometry"/></mxCell><mxCell id="a4" value="&lt;b&gt;4.&lt;/b&gt; Parcel found and inside the selected village?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="500" y="765" width="210" height="128" as="geometry"/></mxCell><mxCell id="a4m" value="Correct the details, or choose the valuation area manually with a reason (flagged for SR)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="779" width="200" height="100" as="geometry"/></mxCell><mxCell id="a5" value="&lt;b&gt;5.&lt;/b&gt; Match parcel to CVC valuation area, road and rural / urban zone (spatial match)&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;GIS valuation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="505" y="929" width="200" height="100" as="geometry"/></mxCell><mxCell id="a6" value="&lt;b&gt;6.&lt;/b&gt; Fetch the Active CVC guideline rate version for the date of execution&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Sec. 45-B; Sec. 2(mm)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="505" y="1079" width="200" height="100" as="geometry"/></mxCell><mxCell id="a7" value="&lt;b&gt;7.&lt;/b&gt; Select property type and features (Agri: dry / wet / bhagayat; Non-agri: residential / commercial / industrial; building)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="1229" width="200" height="100" as="geometry"/></mxCell><mxCell id="a8" value="&lt;b&gt;8.&lt;/b&gt; Calculate guideline value: extent (m²) × rate + building / structure value" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="505" y="1379" width="200" height="100" as="geometry"/></mxCell><mxCell id="a9" value="&lt;b&gt;9.&lt;/b&gt; Enter the consideration / value set forth in the instrument&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Sec. 27, 28(3)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="1529" width="200" height="100" as="geometry"/></mxCell><mxCell id="a10" value="&lt;b&gt;10.&lt;/b&gt; Market value = higher of guideline value and consideration; apply Schedule article&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Sec. 2(mm), 3&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="505" y="1679" width="200" height="100" as="geometry"/></mxCell><mxCell id="a11" value="&lt;b&gt;11.&lt;/b&gt; Calculate stamp duty and registration fee; show summary with GIS map snapshot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="505" y="1829" width="200" height="100" as="geometry"/></mxCell><mxCell id="a12" value="&lt;b&gt;12.&lt;/b&gt; Review the valuation summary and submit the application" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="1979" width="200" height="100" as="geometry"/></mxCell><mxCell id="a13" value="&lt;b&gt;13.&lt;/b&gt; Valuation details correct?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1015" y="1965" width="210" height="128" as="geometry"/></mxCell><mxCell id="a13r" value="Send back for revaluation with remarks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1240" y="1979" width="200" height="100" as="geometry"/></mxCell><mxCell id="a14" value="&lt;b&gt;14.&lt;/b&gt; Reason to believe market value not truly set forth?&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Sec. 45-A(1)&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1015" y="2115" width="210" height="128" as="geometry"/></mxCell><mxCell id="a14y" value="Go to Process B — Sec. 45-A undervaluation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1240" y="2129" width="200" height="100" as="geometry"/></mxCell><mxCell id="a15" value="&lt;b&gt;15.&lt;/b&gt; Accept valuation; continue to payment and registration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1020" y="2279" width="200" height="100" as="geometry"/></mxCell><mxCell id="a_end" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1305" y="2294" width="70" height="70" as="geometry"/></mxCell><mxCell id="e_a_start_a1_25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a_start" target="a1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_a1_a2_26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_a2_a3_27" value="Property identifiers" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_a3_a4_28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFil