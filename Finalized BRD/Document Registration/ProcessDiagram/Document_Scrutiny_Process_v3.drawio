<mxfile host="app.diagrams.net" type="device"><diagram id="Document Scrutiny" name="Document Scrutiny"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2060" pageHeight="3724" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lane_cit" value="Citizen / Applicant&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px'&gt;Party or document writer&lt;/span&gt;" style="swimlane;horizontal=1;html=1;startSize=64;whiteSpace=wrap;fillColor=#dae8fc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="90" width="300" height="3444" as="geometry"/></mxCell><mxCell id="lane_sys" value="Kaveri System&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px'&gt;Kaveri Online Services&lt;/span&gt;" style="swimlane;horizontal=1;html=1;startSize=64;whiteSpace=wrap;fillColor=#d5e8d4;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="90" width="400" height="3444" as="geometry"/></mxCell><mxCell id="lane_sro" value="Sub-Registrar&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px'&gt;Registration Office&lt;/span&gt;" style="swimlane;horizontal=1;html=1;startSize=64;whiteSpace=wrap;fillColor=#fff2cc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="700" y="90" width="760" height="3444" as="geometry"/></mxCell><mxCell id="lane_ms" value="Kaveri Microservices&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px'&gt;Separate services&lt;/span&gt;" style="swimlane;horizontal=1;html=1;startSize=64;whiteSpace=wrap;fillColor=#ffe6cc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1460" y="90" width="280" height="3444" as="geometry"/></mxCell><mxCell id="lane_ext" value="External Systems&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px'&gt;E-Swathu, BBMP E-Aasthi, E-Aasthi, BDA, KHB, Bhoomi, Mojini&lt;/span&gt;" style="swimlane;horizontal=1;html=1;startSize=64;whiteSpace=wrap;fillColor=#f8cecc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1740" y="90" width="280" height="3444" as="geometry"/></mxCell><mxCell id="title" value="&lt;b style='font-size:20px'&gt;Document Registration — Scrutiny by the Sub-Registrar (v3)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;How the Sub-Registrar checks a submitted registration application and approves it for payment, reverts it for correction or rejects it&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="2020" height="70" as="geometry"/></mxCell><mxCell id="s" value="Start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="115" y="199" width="70" height="70" as="geometry"/></mxCell><mxCell id="prev" value="Application submitted for verification and approval&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Previous stage: citizen pre-registration entry&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="342" width="200" height="104" as="geometry"/></mxCell><mxCell id="open" value="&lt;b&gt;1.&lt;/b&gt; Open the Pending Scrutiny list, search by application number and open the application" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="980" y="502" width="200" height="104" as="geometry"/></mxCell><mxCell id="show" value="&lt;b&gt;2.&lt;/b&gt; Show the submitted deed (PDF) and the document details: header, properties, parties, title flow, consideration, covenants and witnesses. Prepare the verification checklist with the captured data shown against each item&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Checklist = common checks + checks for the confirmed Article&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="370" y="639" width="260" height="150" as="geometry"/></mxCell><mxCell id="review" value="&lt;b&gt;3.&lt;/b&gt; Review the submitted deed and the document details; download the deed or view the history of earlier actions if needed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="822" width="240" height="104" as="geometry"/></mxCell><mxCell id="common" value="&lt;b&gt;4.&lt;/b&gt; Common checks:&lt;div style='text-align:left'&gt;• Transaction type&lt;br&gt;• Property details imported from the source of truth are intact&lt;br&gt;• Article selected for the document&lt;br&gt;• Exemption claimed (if any)&lt;br&gt;• Area used for property valuation&lt;br&gt;• Court / government / 22-B stays&lt;br&gt;• Property within the Sub-Registrar Office limits (Sec. 28, Registration Act)&lt;br&gt;• Executants, claimants and witnesses captured&lt;br&gt;• At least two witnesses with full details&lt;br&gt;• Denoting / credit claim and any uploaded earlier document (if any)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="979.0" width="320" height="270" as="geometry"/></mxCell><mxCell id="sot" value="&lt;b&gt;5.&lt;/b&gt; Show the current owners and property details from the source of truth for cross-checking" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1780" y="1062.0" width="200" height="104" as="geometry"/></mxCell><mxCell id="article" value="&lt;b&gt;6.&lt;/b&gt; Checks for the confirmed Article, e.g. Sale 20(1): stamp duty on the higher of market value and consideration; absolute transfer of ownership; no conditions resembling a lease or mortgage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="1289" width="320" height="130" as="geometry"/></mxCell><mxCell id="gv_q" value="&lt;b&gt;7.&lt;/b&gt; Property guidance value to be re-calculated?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="980" y="1452" width="200" height="124" as="geometry"/></mxCell><mxCell id="gv_in" value="&lt;b&gt;8.&lt;/b&gt; Correct the valuation details (e.g. area, property type, use) and re-calculate the guidance value" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1240" y="1622" width="200" height="104" as="geometry"/></mxCell><mxCell id="gv_ms" value="&lt;b&gt;9.&lt;/b&gt; Guidance Value service: re-calculate the property guidance value&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Separate microservice&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1500" y="1622" width="200" height="104" as="geometry"/></mxCell><mxCell id="fee_q" value="&lt;b&gt;10.&lt;/b&gt; Stamp duty and other fees to be re-calculated?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="980" y="1772" width="200" height="124" as="geometry"/></mxCell><mxCell id="fee_ms" value="&lt;b&gt;11.&lt;/b&gt; Fee Calculation service: re-calculate the stamp duty, surcharge, cess, registration fee and other fees&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Separate microservice; old and new amounts kept in the history&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1500" y="1924" width="200" height="140" as="geometry"/></mxCell><mxCell id="mark" value="&lt;b&gt;12.&lt;/b&gt; Mark each item Agree or Disagree, add remarks where needed and save the checklist" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="2102" width="240" height="104" as="geometry"/></mxCell><mxCell id="marked" value="&lt;b&gt;13.&lt;/b&gt; Every checklist item marked?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="2252" width="200" height="124" as="geometry"/></mxCell><mxCell id="saved" value="&lt;b&gt;14.&lt;/b&gt; Save the checklist and mark the scrutiny as Completed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="2422" width="200" height="104" as="geometry"/></mxCell><mxCell id="decide" value="&lt;b&gt;15.&lt;/b&gt; Decision on the application?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="980" y="2572" width="200" height="124" as="geometry"/></mxCell><mxCell id="revert" value="&lt;b&gt;16b.&lt;/b&gt; Revert: give the corrections needed (visible to the applicant)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="2742" width="200" height="104" as="geometry"/></mxCell><mxCell id="approve" value="&lt;b&gt;16a.&lt;/b&gt; Approve for payment; add internal remarks if needed (not visible to the applicant)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="980" y="2742" width="200" height="104" as="geometry"/></mxCell><mxCell id="reject" value="&lt;b&gt;16c.&lt;/b&gt; Reject: give the reason for rejection. Kaveri closes the application and notifies the applicant" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1240" y="2734" width="200" height="120" as="geometry"/></mxCell><mxCell id="reject_end" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1305" y="2919" width="70" height="70" as="geometry"/></mxCell><mxCell id="revert_sys" value="&lt;b&gt;17b.&lt;/b&gt; Return the application to the applicant with the remarks and notify them" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="2902" width="200" height="104" as="geometry"/></mxCell><mxCell id="correct" value="&lt;b&gt;18b.&lt;/b&gt; Correct the application as per the remarks and resubmit it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="3062" width="200" height="104" as="geometry"/></mxCell><mxCell id="approve_sys" value="&lt;b&gt;17a.&lt;/b&gt; Mark the application Approved for Payment with the final (re-calculated, if any) amounts, approve any exemption or denoting claim, release the payment hold and notify the applicant" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="370" y="3039" width="260" height="150" as="geometry"/></mxCell><mxCell id="next" value="&lt;b&gt;18a.&lt;/b&gt; Pay the stamp duty and fees, eSign and book the appointment&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Next stage&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="3222" width="200" height="104" as="geometry"/></mxCell><mxCell id="e" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="115" y="3399" width="70" height="70" as="geometry"/></mxCell><mxCell id="e_s_prev_32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s" target="prev"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_prev_open_33" value="Submitted" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="prev" target="open"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_open_show_34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="open" target="show"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_show_review_35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="show" target="review"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_review_common_36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="review" target="common"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_common_sot_37" value="Cross-check (if needed)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;startArrow=block;startFill=1;" edge="1" parent="1" source="common" target="sot"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_common_article_38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="common" target="article"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_article_gv_q_39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="article" target="gv_q"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_gv_q_gv_in_40" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="gv_q" target="gv_in"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_gv_in_gv_ms_41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="gv_in" target="gv_ms"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_gv_ms_fee_ms_42" value="New guidance value" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="gv_ms" target="fee_ms"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_gv_q_fee_q_43" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="gv_q" target="fee_q"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_fee_q_fee_ms_44" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="fee_q" target="fee_ms"><mxGeometry x="0.0" relative="1" as="geometry"><Array as="points"><mxPoint x="1340" y="1834"/><mxPoint x="1340" y="1994"/></Array></mxGeometry></mxCell><mxCell id="e_fee_q_mark_45" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="fee_q" target="mark"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_fee_ms_mark_46" value="Re-calculated amounts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="fee_ms" target="mark"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_mark_marked_47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="mark" target="marked"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_marked_mark_48" value="No" style="edgeStyle=orthogonalEd