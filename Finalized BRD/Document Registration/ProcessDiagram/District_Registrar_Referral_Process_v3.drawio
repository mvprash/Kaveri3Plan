<mxfile host="app.diagrams.net" type="device"><diagram id="District Registrar Referral" name="District Registrar Referral"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2420" pageHeight="6284" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lane_sro" value="Sub-Registrar&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px'&gt;Referring office&lt;/span&gt;" style="swimlane;horizontal=1;html=1;startSize=64;whiteSpace=wrap;fillColor=#dae8fc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="90" width="360" height="6004" as="geometry"/></mxCell><mxCell id="lane_dr" value="District Registrar&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px'&gt;Registrar under the Registration Act; Deputy Commissioner under the Karnataka Stamp Act&lt;/span&gt;" style="swimlane;horizontal=1;html=1;startSize=64;whiteSpace=wrap;fillColor=#d5e8d4;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="90" width="900" height="6004" as="geometry"/></mxCell><mxCell id="lane_sys" value="Kaveri System&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px'&gt;Kaveri Online Services&lt;/span&gt;" style="swimlane;horizontal=1;html=1;startSize=64;whiteSpace=wrap;fillColor=#fff2cc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1260" y="90" width="440" height="6004" as="geometry"/></mxCell><mxCell id="lane_party" value="Applicant / Parties&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px'&gt;Portal, SMS, email&lt;/span&gt;" style="swimlane;horizontal=1;html=1;startSize=64;whiteSpace=wrap;fillColor=#ffe6cc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1700" y="90" width="380" height="6004" as="geometry"/></mxCell><mxCell id="lane_ext" value="External Systems&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px'&gt;Khajane-II / payment gateway, DSC certifying authority&lt;/span&gt;" style="swimlane;horizontal=1;html=1;startSize=64;whiteSpace=wrap;fillColor=#f8cecc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2080" y="90" width="300" height="6004" as="geometry"/></mxCell><mxCell id="title" value="&lt;b style='font-size:20px'&gt;Document Registration — District Registrar Referral Process (v3)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;How the District Registrar decides an application referred by the Sub-Registrar while registration is kept pending: condonation of delay in presentation or appearance (Sec. 25, 34, Registration Act), under-valuation (Sec. 45-A) and impounded instruments (Sec. 33, 37, 39, 41, Karnataka Stamp Act, 1957); the order goes back to the Sub-Registrar, who resumes registration. Section D: appeal or application against a Sub-Registrar's refusal to register (Sec. 72–77, Registration Act). Section E: further remedies against the District Registrar's order&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="2380" height="70" as="geometry"/></mxCell><mxCell id="sec_1.9" value="&lt;b&gt;A–C. APPLICATIONS REFERRED BY THE SUB-REGISTRAR&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#1f4e79;" vertex="1" parent="1"><mxGeometry x="372" y="464.0" width="640" height="26" as="geometry"/></mxCell><mxCell id="sec_19.1" value="&lt;b&gt;D. APPEAL / APPLICATION AGAINST REFUSAL TO REGISTER (Sec. 72–77)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#1f4e79;" vertex="1" parent="1"><mxGeometry x="372" y="3216.0" width="640" height="26" as="geometry"/></mxCell><mxCell id="sec_31.1" value="&lt;b&gt;E. FURTHER REMEDIES AGAINST THE DISTRICT REGISTRAR'S ORDER&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#1f4e79;" vertex="1" parent="1"><mxGeometry x="372" y="5136.0" width="640" height="26" as="geometry"/></mxCell><mxCell id="s" value="Start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="145" y="199" width="70" height="70" as="geometry"/></mxCell><mxCell id="prev" value="Application referred by the Sub-Registrar; registration kept pending&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Presentation flow: step 18 (condonation of delay), step 34a (Sec. 45-A) or step 34b (Sec. 33)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="329" width="260" height="130" as="geometry"/></mxCell><mxCell id="case" value="&lt;b&gt;1.&lt;/b&gt; Create the referral case in the District Registrar's queue: case number, type, application and document, the Sub-Registrar's reasons and Minute Book entry; status Pending with District Registrar; notify the applicant" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1320" y="479" width="320" height="150" as="geometry"/></mxCell><mxCell id="open" value="&lt;b&gt;2.&lt;/b&gt; Open the referral case: view the document, the presentation and admission endorsements and the Sub-Registrar's reasons" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="654" width="300" height="120" as="geometry"/></mxCell><mxCell id="type" value="&lt;b&gt;3.&lt;/b&gt; Type of referral?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="710" y="814" width="200" height="120" as="geometry"/></mxCell><mxCell id="a_exam" value="&lt;b&gt;4A.&lt;/b&gt; &lt;b&gt;Condonation of delay.&lt;/b&gt; Examine the written application: the reason for the delay (urgent necessity or unavoidable accident) and the period of delay in presentation or appearance; call for an explanation if needed&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Sec. 25(1), 34(1) proviso; Rules 51, 55(i)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="395" y="956" width="250" height="156" as="geometry"/></mxCell><mxCell id="a_fine" value="&lt;b&gt;5A.&lt;/b&gt; Kaveri calculates the fine by the length of delay beyond the time allowed: up to 1 week 1×, up to 1 month 2×, up to 2 months 5×, up to 4 months 10× the registration fee&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Rules 52–54: in addition to the registration fee; once for duplicates; later occasions only the difference&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="395" y="1196.0" width="250" height="156" as="geometry"/></mxCell><mxCell id="a_ord" value="&lt;b&gt;6A.&lt;/b&gt; Pass the order with reasons: condone the delay and direct acceptance for registration / admission to registration on payment of the fine of ₹… for a delay of …, or reject the application&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Sec. 25(1), 34(1) proviso; Rule 55(ii)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="395" y="1436" width="250" height="156" as="geometry"/></mxCell><mxCell id="b_notice" value="&lt;b&gt;4B.&lt;/b&gt; &lt;b&gt;Sec. 45-A under-valuation.&lt;/b&gt; Note the 90-day target date from receipt of the reference; issue notice to the parties with the hearing date; they may file objections and evidence of value&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Sec. 45-A(2), Karnataka Stamp Act&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="685" y="956" width="250" height="156" as="geometry"/></mxCell><mxCell id="b_inq" value="&lt;b&gt;5B.&lt;/b&gt; Hear the parties and hold the inquiry: inspect the property or call for reports if needed, compare with the guidance value and sale instances; determine the market value and the proper duty" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="685" y="1196.0" width="250" height="156" as="geometry"/></mxCell><mxCell id="b_ord" value="&lt;b&gt;6B.&lt;/b&gt; Pass the order, as far as possible within 90 days of the reference: market value, proper duty and the difference payable&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Sec. 45-A(2), (4). Not paid within 90 days of the order: interest at 12% a year. Appeal: Regional Commissioner, after depositing 50% of the difference, Sec. 45-A(5)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="685" y="1436" width="250" height="156" as="geometry"/></mxCell><mxCell id="c_exam" value="&lt;b&gt;4C.&lt;/b&gt; &lt;b&gt;Sec. 33 impounded instrument.&lt;/b&gt; Examine the original instrument sent by the Sub-Registrar: the proper Article, the duty chargeable and the duty paid&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Sec. 37(2), 39(1)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="975" y="956" width="250" height="156" as="geometry"/></mxCell><mxCell id="c_ord" value="&lt;b&gt;5C.&lt;/b&gt; Pass the order: certify that it is duly stamped or not chargeable; or require the proper duty or the deficit, with a penalty of ₹5 or up to ten times the deficit&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Sec. 39(1)(a), (b); penalty may be remitted if impounded only under Sec. 13 or 14&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="975" y="1196.0" width="250" height="156" as="geometry"/></mxCell><mxCell id="dsc" value="&lt;b&gt;7.&lt;/b&gt; Sign the order with the DSC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="710" y="1702.0" width="200" height="104" as="geometry"/></mxCell><mxCell id="ca" value="&lt;b&gt;8.&lt;/b&gt; Certifying authority: certificate valid and not revoked" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2130" y="1702.0" width="200" height="104" as="geometry"/></mxCell><mxCell id="notify" value="&lt;b&gt;9.&lt;/b&gt; Record the order number and date against the document; send the order to the applicant (SMS, email, portal) and a copy to the Sub-Registrar&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Sec. 45-A(4); Rule 55(ii)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1330" y="1849.0" width="300" height="130" as="geometry"/></mxCell><mxCell id="payq" value="&lt;b&gt;10.&lt;/b&gt; Amount payable under the order?&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Fine, duty difference, or deficit duty and penalty&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1360" y="2004.0" width="240" height="140" as="geometry"/></mxCell><mxCell id="pay" value="&lt;b&gt;11.&lt;/b&gt; Pay the amount due through Add Challan (online or challan)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1790" y="2182.0" width="200" height="104" as="geometry"/></mxCell><mxCell id="gw" value="&lt;b&gt;12.&lt;/b&gt; Khajane-II / payment gateway: confirm the payment or challan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2130" y="2342.0" width="200" height="104" as="geometry"/></mxCell><mxCell id="paid" value="&lt;b&gt;13.&lt;/b&gt; Paid?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1380" y="2492.0" width="200" height="124" as="geometry"/></mxCell><mxCell id="endorse" value="&lt;b&gt;14.&lt;/b&gt; Endorse the payment: for Sec. 33, certify on the instrument that the proper duty and penalty were levied, with the amount of each and the name and residence of the payer; for condonation and Sec. 45-A, record the challan against the order&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Sec. 41(1), Karnataka Stamp Act&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="650" y="2639.0" width="320" height="150" as="geometry"/></mxCell><mxCell id="ret" value="&lt;b&gt;15.&lt;/b&gt; Return the document and the order to the Sub-Registrar with the payment status; close the referral case and update the application status&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Sec. 39(3); Rule 116&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1330" y="2809.0" width="300" height="130" as="geometry"/></mxCell><mxCell id="back" value="Sub-Registrar resumes registration&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Presentation flow: step 19 (condonation) or step 35 (Sec. 45-A / Sec. 33). Rejected or not paid: refusal, Rule 171(vi), (viii), (xvi)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="2969.0" width="280" height="130" as="geometry"/></mxCell><mxCell id="e" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="145" y="3143.0" width="70" height="70" as="geometry"/></mxCell><mxCell id="d_s" value="Start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1855" y="3335.0" width="70" height="70" as="geometry"/></mxCell><mxCell id="d_prev" value="Registration refused by the Sub-Registrar; reasons recorded in Book 2 and a copy given&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Presentation flow: step 49&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1760" y="3454.0" width="260" height="120" as="geometry"/></mxCell><mxCell id="d_file" value="&lt;b&gt;16.&lt;/b&gt; Within 30 days of the refusal order, file in person or through an agent holding an authenticated power of attorney (not by post): an appeal under Sec. 72 (any ground other than denial of execution) or an application under Sec. 73 (denial of execution), with a copy of the reasons and verified like a plaint&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Sec. 72(1), 73; Rules 175, 176, 187, 191&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1730" y="3596.0" width="320" height="156" as="geometry"/></mxCell><mxCell id="d_case" value="&lt;b&gt;17.&lt;/b&gt; Create the appeal / application case in the District Registrar's queue with the refusal order, the Book 2 reasons and the original document; check the 30-day limit&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Document held by another person: admitted pending its production, Rule 175(ii)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1330" y="3759.0" width="300" height="150" as="geometry"/></mxCell><mxCell id="d_admit" value="&lt;b&gt;18.&lt;/b&gt; Admissible? Filed in time by a person entitled; Sec. 73 application verified" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="680" y="3919.0" width="260" height="150" as="geometry"/></mxCell><mxCell id="d_nm" value="Not admitted: returned for verification within a stated time, or rejected as not maintainable (time-barred, or document withdrawn by the presenter)&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Rules 178, 190; delay in getting the copy of reasons may be excused, Rule 191(ii)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="950" y="3919.0" width="220" height="150" as="geometry"/></mxCell><mxCell id="d_nm_end" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1175" y="3959.0" width="70" height="70" as="geometry"/></mxCell><mxCell id="d_hear" value="&lt;b&gt;19.&lt;/b&gt; Fix the hearing date; notify the applicant and publish it on the Registrar's notice board; the applicant pays the process fee within a week for notice to the respondent and summons to witnesses&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Rule 179(ii)–(iv); Article XXVI of the Table of Fees&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1330" y="4079.0" width="300" height="150" as="geometry"/></mxCell><mxCell id="d_enq" value="&lt;b&gt;20.&lt;/b&gt; Hear the parties and enquire whether the document was executed and whether the legal requirements are met (Sec. 19–21, 25, etc.); summon and examine witnesses as a Civil Court, adjourn for sufficient cause and decide who bears the costs; record on proceeding sheets (Form 27)&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Sec. 72(1), 74, 75(4); Rules 179, 181, 191(ii), (iii)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="4236.0" width="340" height="156" as="geometry"/></mxCell><mxCell id="d_dec" value="&lt;b&gt;21.&lt;/b&gt; Registration directed?&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Refused if neither party appears, the applicant is absent and the respondent contests, or notice is not served for want of the process fee (Rule 179(v))&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="670" y="4396.0" width="280" height="156" as="geometry"/></mxCell><mxCell id="d_reg" value="&lt;b&gt;22.&lt;/b&gt; Order directing registration, signed with the DSC: recorded separately in the file of appeal orders (not endorsed on the document); abstract endorsed on the appeal; sent to the applicant and the Sub-Registrar (both offices if different); re-presentation unblocked&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Sec. 72(1), 75(1); Rules 180, 183, 185. Minor / unsound-mind ground: register only if the executant appears again and admits execution (Rule 188)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="4572.0" width="280" height="156" as="geometry"/></mxCell><mxCell id="d_ref" value="&lt;b&gt;22a.&lt;/b&gt; Order refusing to direct registration, signed with the DSC: reasons recorded in Book 2; free copy of the reasons on application; sent to the applicant and the Sub-Registrar. No further appeal&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Sec. 76; Rules 179(vii), 180, 183, 186&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="970" y="4572.0" width="260" height="156" as="geometry"/></mxCell><mxCell id="d_re" value="Document re-presented within 30 days of the order: the Sub-Registrar registers it, taking effect from the first presentation; note in Book 2 under the original refusal&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Sec. 72(2), 75(2), (3); Rule 184. Presentation flow&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="4767.0" width="280" height="150" as="geometry"/></mxCell><mxCell id="d_suit" value="Civil suit within 30 days of the Registrar's refusal for a decree directing registration&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Sec. 77; next stage outside Kaveri&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1760" y="4782.0" width="260" height="120" as="geometry"/></mxCell><mxCell id="d_e1" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="145" y="4967.0" width="70" height="70" as="geometry"/></mxCell><mxCell id="d_e2" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1855" y="4967.0" width="70" height="70" as="geometry"/></mxCell><mxCell id="e_s" value="Start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1855" y="5255.0" width="70" height="70" as="geometry"/></mxCell><mxCell id="e_agg" value="&lt;b&gt;23.&lt;/b&gt; Party aggrieved by the District Registrar's order (step 9 or step 22a) chooses a further remedy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1760" y="5379.0" width="260" height="110" as="geometry"/></mxCell><mxCell id="e_q" value="&lt;b&gt;24.&lt;/b&gt; Order made under?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1380" y="5507.0" width="200" height="110" as="geometry"/></mxCell><mxCell id="e_a" value="Condonation of delay (A): no appeal. The Inspector General may remit all or part of the fine above the registration fee&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Sec. 70, Registration Act&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="375" y="5669.0" width="210" height="170" as="geometry"/></mxCell><mxCell id="e_b" value="Sec. 45-A order (B): appeal to the Regional Commissioner after depositing 50% of the duty difference; deposit refunded if the duty paid is found sufficient. The Chief Controlling Revenue Authority may also revise the order within 5 years&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Sec. 45-A(5), 53-A, Karnataka Stamp Act&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="595" y="5669.0" width="210" height="170" as="geometry"/></mxCell><mxCell id="e_c" value="Sec. 39 impounding order (C): no appeal. Refund of penalty (apply within 1 year of payment) or of excess duty (within 6 months of registration) by the Chief Controlling Revenue Authority; revision within 5 years; reference to the High Court&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Sec. 44, 53, 53-A, 54, Karnataka Stamp Act&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="815" y="5669.0" width="210" height="170" as="geometry"/></mxCell><mxCell id="e_d" value="Refusal to direct registration (D): no appeal; civil suit within 30 days for a decree directing registration&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Sec. 76(2), 77, Registration Act (see step 22a)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1035" y="5669.0" width="210" height="170" as="geometry"/></mxCell><mxCell id="e_end" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="775" y="5927.0" width="70" height="70" as="geometry"/></mxCell><mxCell id="e_s_prev_57" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s" target="prev"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_prev_case_58" value="Referred" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="prev" target="case"><mxGeometry x="-0.8" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_case_open_59" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="case" target="open"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_open_type_60" value="" style="edgeStyle=orthogonalEdgeStyle;roun