<mxfile host="app.diagrams.net" type="device"><diagram id="Document Scrutiny" name="Document Scrutiny"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1780" pageHeight="3244" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lane_cit" value="Citizen / Applicant&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px'&gt;Party or document writer&lt;/span&gt;" style="swimlane;horizontal=1;html=1;startSize=64;whiteSpace=wrap;fillColor=#dae8fc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="90" width="300" height="2964" as="geometry"/></mxCell><mxCell id="lane_sys" value="Kaveri System&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px'&gt;Kaveri Online Services&lt;/span&gt;" style="swimlane;horizontal=1;html=1;startSize=64;whiteSpace=wrap;fillColor=#d5e8d4;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="90" width="400" height="2964" as="geometry"/></mxCell><mxCell id="lane_sro" value="Sub-Registrar&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px'&gt;Registration Office&lt;/span&gt;" style="swimlane;horizontal=1;html=1;startSize=64;whiteSpace=wrap;fillColor=#fff2cc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="700" y="90" width="760" height="2964" as="geometry"/></mxCell><mxCell id="lane_ext" value="External Systems&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px'&gt;E-Swathu, BBMP E-Aasthi, E-Aasthi, BDA, KHB, Bhoomi, Mojini&lt;/span&gt;" style="swimlane;horizontal=1;html=1;startSize=64;whiteSpace=wrap;fillColor=#ffe6cc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1460" y="90" width="280" height="2964" as="geometry"/></mxCell><mxCell id="title" value="&lt;b style='font-size:20px'&gt;Document Registration — Scrutiny by the Sub-Registrar (v1)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;How the Sub-Registrar checks a submitted registration application and approves it for payment, reverts it for correction or rejects it&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="1740" height="70" as="geometry"/></mxCell><mxCell id="s" value="Start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="115" y="199" width="70" height="70" as="geometry"/></mxCell><mxCell id="prev" value="Application submitted for verification and approval&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Previous stage: citizen pre-registration entry&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="342" width="200" height="104" as="geometry"/></mxCell><mxCell id="queue" value="&lt;b&gt;1.&lt;/b&gt; Add the application to the Pending Scrutiny list of the Sub-Registrar Office with jurisdiction&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;List shows application number and date, transaction type, applicant, submitted on and properties&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="489" width="240" height="130" as="geometry"/></mxCell><mxCell id="open" value="&lt;b&gt;2.&lt;/b&gt; Open the Pending Scrutiny list, search by application number and open the application" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="980" y="662" width="200" height="104" as="geometry"/></mxCell><mxCell id="show" value="&lt;b&gt;3.&lt;/b&gt; Show the submitted deed (PDF) and the document details: header, properties, parties, title flow, consideration, covenants and witnesses. Prepare the verification checklist with the captured data shown against each item&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Checklist = common checks + checks for the confirmed Article&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="370" y="799" width="260" height="150" as="geometry"/></mxCell><mxCell id="review" value="&lt;b&gt;4.&lt;/b&gt; Review the submitted deed and the document details; download the deed or view the history of earlier actions if needed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="982" width="240" height="104" as="geometry"/></mxCell><mxCell id="common" value="&lt;b&gt;5.&lt;/b&gt; Common checks:&lt;div style='text-align:left'&gt;• Transaction type&lt;br&gt;• Property details imported from the source of truth are intact&lt;br&gt;• Article selected for the document&lt;br&gt;• Exemption claimed (if any)&lt;br&gt;• Area used for property valuation&lt;br&gt;• Court / government / 22-B stays&lt;br&gt;• Property within the Sub-Registrar Office limits (Sec. 28, Registration Act)&lt;br&gt;• Executants, claimants and witnesses captured&lt;br&gt;• At least two witnesses with full details&lt;br&gt;• Denoting / credit claim and any uploaded earlier document (if any)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="1139.0" width="320" height="270" as="geometry"/></mxCell><mxCell id="sot" value="&lt;b&gt;6.&lt;/b&gt; Show the current owners and property details from the source of truth for cross-checking" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1500" y="1222.0" width="200" height="104" as="geometry"/></mxCell><mxCell id="article" value="&lt;b&gt;7.&lt;/b&gt; Checks for the confirmed Article, e.g. Sale 20(1): stamp duty on the higher of market value and consideration; absolute transfer of ownership; no conditions resembling a lease or mortgage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="1449" width="320" height="130" as="geometry"/></mxCell><mxCell id="mark" value="&lt;b&gt;8.&lt;/b&gt; Mark each item Agree or Disagree, add remarks where needed and save the checklist" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="1622" width="240" height="104" as="geometry"/></mxCell><mxCell id="marked" value="&lt;b&gt;9.&lt;/b&gt; Every checklist item marked?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="1772" width="200" height="124" as="geometry"/></mxCell><mxCell id="saved" value="&lt;b&gt;10.&lt;/b&gt; Save the checklist and mark the scrutiny as Completed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="1942" width="200" height="104" as="geometry"/></mxCell><mxCell id="decide" value="&lt;b&gt;11.&lt;/b&gt; Decision on the application?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="980" y="2092" width="200" height="124" as="geometry"/></mxCell><mxCell id="revert" value="&lt;b&gt;12b.&lt;/b&gt; Revert: give the corrections needed (visible to the applicant)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="2262" width="200" height="104" as="geometry"/></mxCell><mxCell id="approve" value="&lt;b&gt;12a.&lt;/b&gt; Approve for payment; add internal remarks if needed (not visible to the applicant)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="980" y="2262" width="200" height="104" as="geometry"/></mxCell><mxCell id="reject" value="&lt;b&gt;12c.&lt;/b&gt; Reject: give the reason for rejection. Kaveri closes the application and notifies the applicant" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1240" y="2254" width="200" height="120" as="geometry"/></mxCell><mxCell id="reject_end" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1305" y="2439" width="70" height="70" as="geometry"/></mxCell><mxCell id="revert_sys" value="&lt;b&gt;13b.&lt;/b&gt; Return the application to the applicant with the remarks and notify them" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="2422" width="200" height="104" as="geometry"/></mxCell><mxCell id="correct" value="&lt;b&gt;14b.&lt;/b&gt; Correct the application as per the remarks and resubmit it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="2582" width="200" height="104" as="geometry"/></mxCell><mxCell id="approve_sys" value="&lt;b&gt;13a.&lt;/b&gt; Mark the application Approved for Payment, approve any exemption or denoting claim, release the payment hold and notify the applicant" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="2569" width="240" height="130" as="geometry"/></mxCell><mxCell id="next" value="&lt;b&gt;14a.&lt;/b&gt; Pay the stamp duty and fees, eSign and book the appointment&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Next stage&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="2742" width="200" height="104" as="geometry"/></mxCell><mxCell id="e" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="115" y="2919" width="70" height="70" as="geometry"/></mxCell><mxCell id="e_s_prev_27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s" target="prev"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_prev_queue_28" value="Submitted" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="prev" target="queue"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_queue_open_29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="queue" target="open"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_open_show_30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="open" target="show"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_show_review_31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="show" target="review"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_review_common_32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="review" target="common"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_common_sot_33" value="Cross-check (if needed)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;startArrow=block;startFill=1;" edge="1" parent="1" source="common" target="sot"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_common_article_34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="common" target="article"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_article_mark_35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="article" target="mark"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_mark_marked_36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="mark" target="marked"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_marked_mark_37" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#b85450;fontColor=#b85450;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="marked" target="mark"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_marked_saved_38" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="marked" target="saved"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_saved_decide_39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="saved" target="decide"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_decide_approve_40" value="Approve" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="decide" target="approve"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_decide_revert_41" value="Revert" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="decide" target="revert"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_decide_reject_42" value="Reject" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#b85450;fontColor=#b85450;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="decide" target="reject"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_reject_reject_end_43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="reject" target="reject_end"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_revert_revert_sys_44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="revert" target="revert_sys"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_revert_sys_correct_45" value="Reverted" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="revert_sys" target="correct"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_correct_queue_46" value="Resubmitted" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#b85450;fontColor=#b85450;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="correct" target="queue"><mxGeometry x="0.0" relative="1" as="geometry"><Array as="points"><mxPoint x="16" y="2634"/><mxPoint x="16" y="554"/></Array></mxGeometry></mxCell><mxCell id="e_approve_approve_sys_47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="approve" target="approve_sys"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_approve_sys_next_48" value="Approved for payment" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="approve_sys" target="next"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_next_e_49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="next" target="e"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="legend_t" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;align=left;" vertex="1" parent="1"><mxGeometry x="0" y="3084" width="120" height="24" as="geometry"/></mxCell><mxCell id="legend_0" value="Start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="3114" width="70" height="70" as="geometry"/></mxCell><mxCell id="legend_1" value="Step done by the actor in that lane" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="94" y="3114" width="160" height="56" as="geometry"/></mxCell><mxCell id="legend_2" value="Decision / check" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="278" y="3114" width="160" height="56" as="geometry"/></mxCell><mxCell id="legend_3" value="Next stage (outside this process)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="462" y="3114" width="160" height="56" as="geometry"/></mxCell><mxCell id="legend_4" value="Stop / cannot continue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="646" y="3114" width="160" height="56" as="geometry"/></mxCell><mxCell id="legend_5" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="830" y="3114" width="70" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>