<mxfile host="app.diagrams.net" type="device"><diagram id="Payment eSign Appointment" name="Payment eSign Appointment"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2360" pageHeight="5804" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lane_cit" value="Citizen / Applicant&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px'&gt;Party or document writer&lt;/span&gt;" style="swimlane;horizontal=1;html=1;startSize=64;whiteSpace=wrap;fillColor=#dae8fc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="90" width="560" height="5524" as="geometry"/></mxCell><mxCell id="lane_party" value="Party&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px'&gt;Executant / claimant / representative — portal or mobile&lt;/span&gt;" style="swimlane;horizontal=1;html=1;startSize=64;whiteSpace=wrap;fillColor=#d5e8d4;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="560" y="90" width="520" height="5524" as="geometry"/></mxCell><mxCell id="lane_wit" value="Witness&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px'&gt;Portal or mobile&lt;/span&gt;" style="swimlane;horizontal=1;html=1;startSize=64;whiteSpace=wrap;fillColor=#fff2cc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1080" y="90" width="520" height="5524" as="geometry"/></mxCell><mxCell id="lane_sys" value="Kaveri System&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px'&gt;Kaveri Online Services&lt;/span&gt;" style="swimlane;horizontal=1;html=1;startSize=64;whiteSpace=wrap;fillColor=#ffe6cc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1600" y="90" width="420" height="5524" as="geometry"/></mxCell><mxCell id="lane_ext" value="External Systems&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px'&gt;Khajane-II / payment gateway, e-Sign service provider (UIDAI), DSC certifying authority&lt;/span&gt;" style="swimlane;horizontal=1;html=1;startSize=64;whiteSpace=wrap;fillColor=#f8cecc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2020" y="90" width="300" height="5524" as="geometry"/></mxCell><mxCell id="title" value="&lt;b style='font-size:20px'&gt;Document Registration — Payment, Digital Signing and Appointment (v1)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;What the citizen does after the Sub-Registrar approves the application for payment: full or partial payment, e-Sign / DSC by all parties and witnesses, and appointment booking&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="2320" height="70" as="geometry"/></mxCell><mxCell id="s" value="Start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="145" y="199" width="70" height="70" as="geometry"/></mxCell><mxCell id="prev" value="Application Approved for Payment by the Sub-Registrar&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Previous stage: scrutiny&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="342" width="200" height="104" as="geometry"/></mxCell><mxCell id="notify" value="&lt;b&gt;1.&lt;/b&gt; Notify the applicant (SMS, email, portal) and show the final payable amounts: stamp duty, surcharge, cess, registration fee and other fees&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Includes any amounts re-calculated by the Sub-Registrar&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1670" y="484" width="280" height="140" as="geometry"/></mxCell><mxCell id="agree" value="&lt;b&gt;2.&lt;/b&gt; Agree to pay the full amount?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="652" width="200" height="124" as="geometry"/></mxCell><mxCell id="full" value="&lt;b&gt;3a.&lt;/b&gt; Full payment: pay online through the payment gateway or enter the challan details" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="822" width="200" height="104" as="geometry"/></mxCell><mxCell id="partial" value="&lt;b&gt;3b.&lt;/b&gt; Partial payment: choose the reason and pay the amount agreed&lt;div style='text-align:left'&gt;• Does not accept the Sub-Registrar's market value (under-valuation) — referred to the District Registrar, Sec. 45-A, Karnataka Stamp Act, 1957&lt;br&gt;• Pays less stamp duty than required (short levy) — impounded, Sec. 33, Karnataka Stamp Act, 1957&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="769" width="260" height="210" as="geometry"/></mxCell><mxCell id="gateway" value="&lt;b&gt;4.&lt;/b&gt; Khajane-II / payment gateway: confirm the payment or challan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2070" y="1030.0" width="200" height="104" as="geometry"/></mxCell><mxCell id="paid" value="&lt;b&gt;5.&lt;/b&gt; Payment confirmed for the amount chosen?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1710" y="1180.0" width="200" height="124" as="geometry"/></mxCell><mxCell id="receipt" value="&lt;b&gt;6.&lt;/b&gt; Generate the payment receipt. Partial payment: record the amount paid, the deficit and the reason; mark for Sec. 45-A referral or Sec. 33 impounding" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1660" y="1337.0" width="300" height="130" as="geometry"/></mxCell><mxCell id="prep" value="&lt;b&gt;7.&lt;/b&gt; Prepare the final deed for signing and the signing list: executants, then claimants / representatives, then witnesses&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Applicant can track each signer: Pending, Link sent, Signed, Failed&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1660" y="1497.0" width="300" height="130" as="geometry"/></mxCell><mxCell id="p_where" value="&lt;b&gt;8.&lt;/b&gt; Next party signs in the portal or on a mobile?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="1689.0" width="200" height="130" as="geometry"/></mxCell><mxCell id="p_link" value="&lt;b&gt;9.&lt;/b&gt; Send a secure, time-limited signing link to the party's registered mobile / email&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Applicant can resend an expired link&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1690" y="1854.0" width="240" height="120" as="geometry"/></mxCell><mxCell id="p_review" value="&lt;b&gt;10.&lt;/b&gt; Open the deed (portal or mobile link), review it and agree to sign" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="2022.0" width="200" height="104" as="geometry"/></mxCell><mxCell id="p_how" value="&lt;b&gt;11.&lt;/b&gt; Sign with e-Sign or DSC?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="2172.0" width="200" height="124" as="geometry"/></mxCell><mxCell id="p_esign" value="&lt;b&gt;12a.&lt;/b&gt; e-Sign: enter Aadhaar number / Virtual ID and the OTP from UIDAI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="590" y="2342.0" width="200" height="104" as="geometry"/></mxCell><mxCell id="p_dsc" value="&lt;b&gt;12b.&lt;/b&gt; DSC: connect the DSC token and enter the PIN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="2342.0" width="200" height="104" as="geometry"/></mxCell><mxCell id="p_ext" value="&lt;b&gt;13.&lt;/b&gt; e-Sign service provider returns the signed PDF; certifying authority confirms the DSC is valid and not revoked" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2070" y="2494.0" width="200" height="120" as="geometry"/></mxCell><mxCell id="p_ok" value="&lt;b&gt;14.&lt;/b&gt; Signature valid and signer matches the party?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1700" y="2649.0" width="220" height="130" as="geometry"/></mxCell><mxCell id="p_all" value="&lt;b&gt;15.&lt;/b&gt; All parties signed?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1710" y="2812.0" width="200" height="124" as="geometry"/></mxCell><mxCell id="w_avail" value="&lt;b&gt;16.&lt;/b&gt; Next witness available to sign?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="3004.0" width="200" height="124" as="geometry"/></mxCell><mxCell id="w_replace" value="&lt;b&gt;17.&lt;/b&gt; Replace the witness: enter the new witness's details" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="3158.0" width="200" height="104" as="geometry"/></mxCell><mxCell id="w_where" value="&lt;b&gt;18.&lt;/b&gt; Witness signs in the portal or on a mobile?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="3305.0" width="200" height="130" as="geometry"/></mxCell><mxCell id="w_link" value="&lt;b&gt;19.&lt;/b&gt; Send a secure, time-limited signing link to the witness's registered mobile / email" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1690" y="3478.0" width="240" height="104" as="geometry"/></mxCell><mxCell id="w_review" value="&lt;b&gt;20.&lt;/b&gt; Open the deed, check the parties' signatures and agree to attest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1220" y="3638.0" width="200" height="104" as="geometry"/></mxCell><mxCell id="w_how" value="&lt;b&gt;21.&lt;/b&gt; Sign with e-Sign or DSC?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1220" y="3788.0" width="200" height="124" as="geometry"/></mxCell><mxCell id="w_esign" value="&lt;b&gt;22a.&lt;/b&gt; e-Sign: enter Aadhaar number / Virtual ID and the OTP from UIDAI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1110" y="3958.0" width="200" height="104" as="geometry"/></mxCell><mxCell id="w_dsc" value="&lt;b&gt;22b.&lt;/b&gt; DSC: connect the DSC token and enter the PIN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1330" y="3958.0" width="200" height="104" as="geometry"/></mxCell><mxCell id="w_ext" value="&lt;b&gt;23.&lt;/b&gt; e-Sign service provider returns the signed PDF; certifying authority confirms the DSC is valid and not revoked" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2070" y="4110.0" width="200" height="120" as="geometry"/></mxCell><mxCell id="w_ok" value="&lt;b&gt;24.&lt;/b&gt; Signature valid and signer matches the witness captured?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1695" y="4262.0" width="230" height="136" as="geometry"/></mxCell><mxCell id="w_all" value="&lt;b&gt;25.&lt;/b&gt; At least two witnesses signed?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1710" y="4428.0" width="200" height="124" as="geometry"/></mxCell><mxCell id="lock" value="&lt;b&gt;26.&lt;/b&gt; Lock the fully signed deed so it cannot be changed; mark the application Signed – ready for appointment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1680" y="4598.0" width="260" height="104" as="geometry"/></mxCell><mxCell id="slot" value="&lt;b&gt;27.&lt;/b&gt; Choose a date and time slot at the Sub-Registrar Office with jurisdiction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="4758.0" width="200" height="104" as="geometry"/></mxCell><mxCell id="slot_ok" value="&lt;b&gt;28.&lt;/b&gt; Slot available?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1710" y="4908.0" width="200" height="124" as="geometry"/></mxCell><mxCell id="confirm" value="&lt;b&gt;29.&lt;/b&gt; Book the slot and send the appointment confirmation (application number, office, date, time, who and what to bring) by SMS, email and portal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1670" y="5065.0" width="280" height="130" as="geometry"/></mxCell><mxCell id="next" value="Present the document at the Sub-Registrar Office&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Next stage: presentation and registration (partial payment: Sec. 45-A referral / Sec. 33 impounding)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="5230.0" width="240" height="120" as="geometry"/></mxCell><mxCell id="e" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="145" y="5415.0" width="70" height="70" as="geometry"/></mxCell><mxCell id="e_s_prev_42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s" target="prev"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_prev_notify_43" value="Approved" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="prev" target="notify"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_notify_agree_44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="notify" target="agree"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_agree_full_45" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="agree" target="full"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_agree_partial_46" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="agree" target="partial"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_full_gateway_47" value="Full amount" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="full" target="gateway"><mxGeometry x="-0.85" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_partial_gateway_48" value="Amount agreed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="partial" target="gateway"><mxGeometry x="-0.6" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_gateway_paid_49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="gateway" target="paid"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_paid_full_50" value="No / short — pay the difference" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#b85450;fontColor=#b85450;exitX=0;exitY=0.5;entryX=0;entryY=0.5;jumpStyle=arc;jumpSize=12;" edge="1" parent="1"