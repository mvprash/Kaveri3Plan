<mxfile host="app.diagrams.net" type="device"><diagram id="Process B - SR Check and Payment" name="Process B - SR Check and Payment"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1310" pageHeight="1564" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lane_cit" value="Citizen / Applicant" style="swimlane;horizontal=1;html=1;startSize=64;whiteSpace=wrap;fillColor=#dae8fc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="90" width="250" height="1284" as="geometry"/></mxCell><mxCell id="lane_sys" value="Kaveri System" style="swimlane;horizontal=1;html=1;startSize=64;whiteSpace=wrap;fillColor=#d5e8d4;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="250" y="90" width="250" height="1284" as="geometry"/></mxCell><mxCell id="lane_sr" value="Sub-Registrar (SR)" style="swimlane;horizontal=1;html=1;startSize=64;whiteSpace=wrap;fillColor=#fff2cc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="500" y="90" width="520" height="1284" as="geometry"/></mxCell><mxCell id="lane_bank" value="Bank / Treasury&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px'&gt;Payment, e-Stamp&lt;/span&gt;" style="swimlane;horizontal=1;html=1;startSize=64;whiteSpace=wrap;fillColor=#ffe6cc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1020" y="90" width="250" height="1284" as="geometry"/></mxCell><mxCell id="title" value="&lt;b style='font-size:20px'&gt;Process B — Sub-Registrar Check and Payment&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;Registration core — Registration, Appointment and Status tracking (27-08-2026 discussion) — BRD Registration Core v1.0&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="1270" height="70" as="geometry"/></mxCell><mxCell id="b_start" value="Start&lt;br&gt;from A" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="337" y="191" width="76" height="76" as="geometry"/></mxCell><mxCell id="b1" value="&lt;b&gt;1.&lt;/b&gt; Check the property and parties against the banned / attached property list&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Karnataka Sec. 22-B&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="275" y="329" width="200" height="100" as="geometry"/></mxCell><mxCell id="b2" value="&lt;b&gt;2.&lt;/b&gt; Open the application; check the details and the property value" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="479" width="200" height="100" as="geometry"/></mxCell><mxCell id="b3" value="&lt;b&gt;3.&lt;/b&gt; Is everything correct?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="520" y="617" width="200" height="124" as="geometry"/></mxCell><mxCell id="b3c" value="Correct only the parts marked by the SR and resubmit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="25" y="629" width="200" height="100" as="geometry"/></mxCell><mxCell id="b3x" value="Refuse with written reasons and inform the applicant&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Sec. 22-B / Sec. 71&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="629" width="200" height="100" as="geometry"/></mxCell><mxCell id="b_end_x" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="862" y="791" width="76" height="76" as="geometry"/></mxCell><mxCell id="b4" value="&lt;b&gt;4.&lt;/b&gt; Send to the applicant for payment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="779" width="200" height="100" as="geometry"/></mxCell><mxCell id="b5" value="&lt;b&gt;5.&lt;/b&gt; Pay stamp duty and fee online, by challan or e-Stamp&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Stamp Act Sec. 10&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="25" y="929" width="200" height="100" as="geometry"/></mxCell><mxCell id="b6" value="&lt;b&gt;6.&lt;/b&gt; Payment received?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1045" y="917" width="200" height="124" as="geometry"/></mxCell><mxCell id="b7" value="&lt;b&gt;7.&lt;/b&gt; Give the receipt and open appointment booking right away" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="275" y="1079" width="200" height="100" as="geometry"/></mxCell><mxCell id="b_end" value="End&lt;br&gt;Go to C" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="337" y="1241" width="76" height="76" as="geometry"/></mxCell><mxCell id="e_b_start_b1_17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b_start" target="b1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_b1_b2_18" value="To SR queue" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLo