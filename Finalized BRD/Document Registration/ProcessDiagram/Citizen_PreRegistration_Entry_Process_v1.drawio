<mxfile host="app.diagrams.net" type="device"><diagram id="Citizen Pre-Registration Entry" name="Citizen Pre-Registration Entry"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1780" pageHeight="5804" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lane_cit" value="Citizen / Applicant&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px'&gt;Party or document writer&lt;/span&gt;" style="swimlane;horizontal=1;html=1;startSize=64;whiteSpace=wrap;fillColor=#dae8fc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="90" width="720" height="5524" as="geometry"/></mxCell><mxCell id="lane_sys" value="Kaveri System&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px'&gt;Kaveri Online Services&lt;/span&gt;" style="swimlane;horizontal=1;html=1;startSize=64;whiteSpace=wrap;fillColor=#d5e8d4;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="720" y="90" width="480" height="5524" as="geometry"/></mxCell><mxCell id="lane_ext" value="External Systems&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px'&gt;E-Swathu, Bhoomi, Mojini, UIDAI&lt;/span&gt;" style="swimlane;horizontal=1;html=1;startSize=64;whiteSpace=wrap;fillColor=#fff2cc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1200" y="90" width="270" height="5524" as="geometry"/></mxCell><mxCell id="lane_sro" value="Registration Office&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px'&gt;Sub-Registrar / Admin&lt;/span&gt;" style="swimlane;horizontal=1;html=1;startSize=64;whiteSpace=wrap;fillColor=#ffe6cc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1470" y="90" width="270" height="5524" as="geometry"/></mxCell><mxCell id="title" value="&lt;b style='font-size:20px'&gt;Document Registration — Citizen Pre-Registration Entry Process&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;How a citizen prepares and submits a document registration application online in Kaveri, up to submission for scrutiny&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="1740" height="70" as="geometry"/></mxCell><mxCell id="s" value="Start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="235" y="199" width="70" height="70" as="geometry"/></mxCell><mxCell id="login" value="&lt;b&gt;1.&lt;/b&gt; Log in to Kaveri Online Services and start a new document registration application" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="170" y="342" width="200" height="104" as="geometry"/></mxCell><mxCell id="appno" value="&lt;b&gt;2.&lt;/b&gt; Create a unique application number" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="502" width="200" height="104" as="geometry"/></mxCell><mxCell id="txn" value="&lt;b&gt;3.&lt;/b&gt; Select the type of transaction (for example Sale)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="170" y="662" width="200" height="104" as="geometry"/></mxCell><mxCell id="addprop" value="&lt;b&gt;4.&lt;/b&gt; Add a property" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="170" y="822" width="200" height="104" as="geometry"/></mxCell><mxCell id="in_ka" value="&lt;b&gt;5.&lt;/b&gt; Is the property in Karnataka?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="170" y="972" width="200" height="124" as="geometry"/></mxCell><mxCell id="outside" value="&lt;b&gt;6.&lt;/b&gt; Outside Karnataka: enter only the property details, property number and property boundaries&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Court / government stays, 22-B stays and liabilities are not checked&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="1142" width="200" height="104" as="geometry"/></mxCell><mxCell id="agri" value="&lt;b&gt;7.&lt;/b&gt; Agriculture or non-agriculture property?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="170" y="1132" width="200" height="124" as="geometry"/></mxCell><mxCell id="nonagri_in" value="&lt;b&gt;8a.&lt;/b&gt; Non-agriculture: give the location (District, Taluk, Hobli, Village) and the Property ID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1302" width="200" height="104" as="geometry"/></mxCell><mxCell id="agri_in" value="&lt;b&gt;8b.&lt;/b&gt; Agriculture: give the location, Survey No. and Hissa No.; say whether the full or a part extent is sold" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="1302" width="200" height="104" as="geometry"/></mxCell><mxCell id="fetch" value="&lt;b&gt;9.&lt;/b&gt; Send property details and owner names (E-Swathu for non-agriculture, Bhoomi RTC for agriculture)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1235" y="1462" width="200" height="104" as="geometry"/></mxCell><mxCell id="partial" value="&lt;b&gt;10.&lt;/b&gt; Agriculture land sold in part?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="170" y="1612" width="200" height="124" as="geometry"/></mxCell><mxCell id="sketch" value="&lt;b&gt;11.&lt;/b&gt; Send the approved sketch (Mojini) with transferors and transferees" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1235" y="1782" width="200" height="104" as="geometry"/></mxCell><mxCell id="transferee" value="&lt;b&gt;12.&lt;/b&gt; Select the transferee and add the sketch details to the property schedule" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="1942" width="200" height="104" as="geometry"/></mxCell><mxCell id="owners" value="&lt;b&gt;13.&lt;/b&gt; Select the owners; enter boundaries, consideration amount and property numbers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="170" y="2102" width="200" height="104" as="geometry"/></mxCell><mxCell id="gv" value="&lt;b&gt;14.&lt;/b&gt; Calculate the guidance value of the property from the approved rates" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="2262" width="200" height="104" as="geometry"/></mxCell><mxCell id="more_prop" value="&lt;b&gt;15.&lt;/b&gt; Save property. Add another property?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="170" y="2412" width="200" height="124" as="geometry"/></mxCell><mxCell id="stays" value="&lt;b&gt;16.&lt;/b&gt; Check each Karnataka property for government / court stays, 22-B stays and liabilities&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Not checked for properties outside Karnataka&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="2582" width="200" height="104" as="geometry"/></mxCell><mxCell id="stay22b" value="&lt;b&gt;17.&lt;/b&gt; Any 22-B stay found?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="770" y="2732" width="200" height="124" as="geometry"/></mxCell><mxCell id="stop" value="Stop: registration cannot continue. (Court stay = warning only; liabilities are added to the duty)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="990" y="2742" width="200" height="104" as="geometry"/></mxCell><mxCell id="stop_end" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1055" y="2919" width="70" height="70" as="geometry"/></mxCell><mxCell id="parties" value="&lt;b&gt;18.&lt;/b&gt; Party details: sellers are taken from owner records; add purchasers, consenting witnesses and witnesses" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="170" y="2902" width="200" height="104" as="geometry"/></mxCell><mxCell id="rep" value="&lt;b&gt;19.&lt;/b&gt; For each party state who acts: self, Power of Attorney holder (registered PoA is verified), guardian of a minor, or institution representative" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="170" y="3062" width="200" height="104" as="geometry"/></mxCell><mxCell id="aadhaar" value="&lt;b&gt;20.&lt;/b&gt; Does the person have Aadhaar?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="170" y="3212" width="200" height="124" as="geometry"/></mxCell><mxCell id="ekyc" value="&lt;b&gt;21a.&lt;/b&gt; UIDAI e-KYC: return name, date of birth, address and photo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1235" y="3382" width="200" height="104" as="geometry"/></mxCell><mxCell id="manual_id" value="&lt;b&gt;21b.&lt;/b&gt; Give Aadhaar Enrollment ID, Passport or PAN, and enter name, date of birth, phone, email and address" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="3382" width="200" height="104" as="geometry"/></mxCell><mxCell id="more_party" value="&lt;b&gt;22.&lt;/b&gt; Save party. All parties and witnesses added?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="170" y="3532" width="200" height="124" as="geometry"/></mxCell><mxCell id="fees" value="&lt;b&gt;23.&lt;/b&gt; Calculate stamp duty, surcharge, cess and registration fee under the correct Article" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="3702" width="200" height="104" as="geometry"/></mxCell><mxCell id="exempt" value="&lt;b&gt;24.&lt;/b&gt; Claim an exemption?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="170" y="3852" width="200" height="124" as="geometry"/></mxCell><mxCell id="exempt_pick" value="&lt;b&gt;25.&lt;/b&gt; Choose ONE exemption (Women 10%, Senior Citizen 20%, Physically Handicapped 30%)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="4022" width="200" height="104" as="geometry"/></mxCell><mxCell id="exempt_sys" value="&lt;b&gt;26.&lt;/b&gt; Reduce the payable amount, mark the claim Pending Verification and hold payment until it is approved" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="4182" width="200" height="104" as="geometry"/></mxCell><mxCell id="recitals" value="&lt;b&gt;27.&lt;/b&gt; Enter the history of title (recitals) in order" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="170" y="4342" width="200" height="104" as="geometry"/></mxCell><mxCell id="payment" value="&lt;b&gt;28.&lt;/b&gt; Enter consideration payment details (mode, amount, date, reference) and covenants (terms)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="170" y="4502" width="200" height="104" as="geometry"/></mxCell><mxCell id="draft" value="&lt;b&gt;29.&lt;/b&gt; Prepare the draft deed (PDF) for the applicant to review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="4662" width="200" height="104" as="geometry"/></mxCell><mxCell id="draft_ok" value="&lt;b&gt;30.&lt;/b&gt; Draft deed correct?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="170" y="4812" width="200" height="124" as="geometry"/></mxCell><mxCell id="submit" value="&lt;b&gt;31.&lt;/b&gt; Submit the application for verification and approval" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="170" y="4982" width="200" height="104" as="geometry"/></mxCell><mxCell id="sent" value="&lt;b&gt;32.&lt;/b&gt; Send the application for scrutiny and tell the applicant they will be notified" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="5142" width="200" height="104" as="geometry"/></mxCell><mxCell id="scrutiny" value="&lt;b&gt;33.&lt;/b&gt; Scrutiny of the application and approval of any exemption; then payment, eSign and appointment&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Next stage&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1505" y="5302" width="200" height="104" as="geometry"/></mxCell><mxCell id="e" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1570" y="5479" width="70" height="70" as="geometry"/></mxCell><mxCell id="e_s_login_44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s" target="login"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_login_appno_45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="login" target="appno"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_appno_txn_46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="appno" target="txn"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_txn_addprop_47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="txn" target="addprop"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_addprop_in_ka_48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="addprop" target="in_ka"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_in_ka_outside_49" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="in_ka" target="outside"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_in_ka_agri_50" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="in_ka" target="agri"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_outside_more_prop_51" value="Property added" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="outside" target="more_prop"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="600" y="2474"/></Array></mxGeometry></mxCell><mxCell id="e_agri_nonagri_in_52" value="Non-agriculture" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="agri" target="nonagri_in"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_agri_agri_in_53" value="Agriculture" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="agri" target="agri_in"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_nonagri_in_fetch_54" value="" style="edgeStyle=orthogonalEdge