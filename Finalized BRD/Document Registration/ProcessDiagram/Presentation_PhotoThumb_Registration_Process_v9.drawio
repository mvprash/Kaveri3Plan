<mxfile host="app.diagrams.net" type="device"><diagram id="Presentation Photo Thumb Registration" name="Presentation Photo Thumb Registration"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2240" pageHeight="11084" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lane_party" value="Parties and Witnesses&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px'&gt;At the Sub-Registrar Office&lt;/span&gt;" style="swimlane;horizontal=1;html=1;startSize=64;whiteSpace=wrap;fillColor=#dae8fc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="90" width="420" height="10804" as="geometry"/></mxCell><mxCell id="lane_sro" value="Sub-Registrar&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px'&gt;Registration Office&lt;/span&gt;" style="swimlane;horizontal=1;html=1;startSize=64;whiteSpace=wrap;fillColor=#d5e8d4;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="90" width="620" height="10804" as="geometry"/></mxCell><mxCell id="lane_deo" value="Data Entry Operator&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px'&gt;Registration Office&lt;/span&gt;" style="swimlane;horizontal=1;html=1;startSize=64;whiteSpace=wrap;fillColor=#fff2cc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1040" y="90" width="420" height="10804" as="geometry"/></mxCell><mxCell id="lane_sys" value="Kaveri System&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px'&gt;Kaveri Online Services&lt;/span&gt;" style="swimlane;horizontal=1;html=1;startSize=64;whiteSpace=wrap;fillColor=#ffe6cc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1460" y="90" width="440" height="10804" as="geometry"/></mxCell><mxCell id="lane_ext" value="External Systems&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px'&gt;UIDAI e-KYC, e-Sign service provider, DSC certifying authority&lt;/span&gt;" style="swimlane;horizontal=1;html=1;startSize=64;whiteSpace=wrap;fillColor=#f8cecc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1900" y="90" width="300" height="10804" as="geometry"/></mxCell><mxCell id="title" value="&lt;b style='font-size:20px'&gt;Document Registration — Presentation, Photo &amp;amp; Thumb Capture, Registration, Refusal and Withdrawal (v9)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;What happens at the Sub-Registrar Office after the appointment: the Sub-Registrar presents the document, records admission (keeping it pending until every executant appears, by summons or commission if needed) and checks for delay in presentation or appearance, the Data Entry Operator captures photos, thumb impressions and e-Signs, and the Sub-Registrar registers the document, keeps it pending for a Sec. 45-A referral or Sec. 33 impounding (decided in the District Registrar Referral Process), or refuses registration (Part XII, Registration Act; Chapter XXIV, Karnataka Registration Rules); the presenter may withdraw the document at any time before registration&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="2200" height="70" as="geometry"/></mxCell><mxCell id="sec_2" value="&lt;b&gt;A. PRESENTATION&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#1f4e79;" vertex="1" parent="1"><mxGeometry x="12" y="480" width="380" height="26" as="geometry"/></mxCell><mxCell id="sec_23.6" value="&lt;b&gt;B. PHOTO, THUMB AND E-SIGN&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#1f4e79;" vertex="1" parent="1"><mxGeometry x="12" y="3936.0" width="380" height="26" as="geometry"/></mxCell><mxCell id="sec_33.6" value="&lt;b&gt;C. REGISTRATION&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#1f4e79;" vertex="1" parent="1"><mxGeometry x="12" y="5536.0" width="380" height="26" as="geometry"/></mxCell><mxCell id="sec_46.05" value="&lt;b&gt;D. REFUSAL TO REGISTER&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#1f4e79;" vertex="1" parent="1"><mxGeometry x="12" y="7528.0" width="380" height="26" as="geometry"/></mxCell><mxCell id="sec_58.05" value="&lt;b&gt;E. WITHDRAWAL BEFORE REGISTRATION&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#1f4e79;" vertex="1" parent="1"><mxGeometry x="12" y="9448.0" width="380" height="26" as="geometry"/></mxCell><mxCell id="s" value="Start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="175" y="199" width="70" height="70" as="geometry"/></mxCell><mxCell id="prev" value="Parties and witnesses arrive at the Sub-Registrar Office at the booked appointment&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Previous stage: payment, digital signing and appointment&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="339" width="240" height="110" as="geometry"/></mxCell><mxCell id="open" value="&lt;b&gt;1.&lt;/b&gt; Open the application from the Presentation list" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="502" width="200" height="104" as="geometry"/></mxCell><mxCell id="show" value="&lt;b&gt;2.&lt;/b&gt; Show the digitally executed deed (with signature status) and the payment for each property: stamp duty, surcharge, cess, registration fee and total" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1540" y="649" width="280" height="130" as="geometry"/></mxCell><mxCell id="check" value="&lt;b&gt;3.&lt;/b&gt; Verification checklist: presenter's identity and right to present; deed matches the submission; payment and stamp duty (a stamp duty shortfall alone does not stop presentation: mark it for impounding at step 34, Sec. 33; Rule 46(ii), (iii)); language, interlineations, property description, map and date of execution (a date altered to avoid the delay fine is not accepted, Rule 50(iii)); Sec. 22-B (forged, prohibited or attached property). Mark Agree / Disagree with remarks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="796" width="360" height="156" as="geometry"/></mxCell><mxCell id="agreed" value="&lt;b&gt;4.&lt;/b&gt; All checklist items agreed?&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Stamp duty shortfall marked for impounding counts as agreed&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1480" y="964" width="210" height="140" as="geometry"/></mxCell><mxCell id="ground" value="&lt;b&gt;5.&lt;/b&gt; Disagree item is a refusal ground? (Rule 171, Sec. 22-B)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1480" y="1124" width="210" height="140" as="geometry"/></mxCell><mxCell id="to_d1" value="Refuse registration: go to D (step 40)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1720" y="1154" width="170" height="80" as="geometry"/></mxCell><mxCell id="withdraw" value="&lt;b&gt;6.&lt;/b&gt; Not presented: the parties cure the defect and return, or the presenter withdraws in writing: go to E (step 50)&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;No appeal (Rule 190)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1475" y="1279" width="220" height="150" as="geometry"/></mxCell><mxCell id="withdraw_end" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1790" y="1319" width="70" height="70" as="geometry"/></mxCell><mxCell id="present" value="&lt;b&gt;7.&lt;/b&gt; Select the presenter from the parties and present the document" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="1462" width="200" height="104" as="geometry"/></mxCell><mxCell id="rec_pres" value="&lt;b&gt;8.&lt;/b&gt; Record the presentation: presenter, date, time and office&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Presenter cannot be changed once admission is recorded (Sec. 32, Registration Act)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1550" y="1614" width="260" height="120" as="geometry"/></mxCell><mxCell id="admit" value="&lt;b&gt;9.&lt;/b&gt; Record admission or denial of execution as each party appears, with the date of appearance&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Refusal grounds: execution denied; minor or unsound mind; death of executant not proved (Sec. 34, 35; Rule 171). Executants may appear at different times (Sec. 34(2))&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="1759" width="300" height="150" as="geometry"/></mxCell><mxCell id="denied" value="&lt;b&gt;10.&lt;/b&gt; Refusal ground at admission?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1485" y="1932" width="200" height="124" as="geometry"/></mxCell><mxCell id="to_d2" value="Refuse registration: go to D (step 40)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1705" y="1954" width="150" height="80" as="geometry"/></mxCell><mxCell id="admitted" value="&lt;b&gt;11.&lt;/b&gt; Another party present at the counter?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1485" y="2092" width="200" height="124" as="geometry"/></mxCell><mxCell id="all_app" value="&lt;b&gt;12.&lt;/b&gt; All executants appeared and admitted?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1480" y="2249" width="210" height="130" as="geometry"/></mxCell><mxCell id="app_pend" value="&lt;b&gt;13.&lt;/b&gt; Keep the document pending as Party Appearance Pending: record who has admitted and who is absent, with the date; record in the Minute Book. Admissions already recorded stay&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Sec. 34(2); Rule 172&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="765" y="2404" width="270" height="140" as="geometry"/></mxCell><mxCell id="app_sys" value="&lt;b&gt;14.&lt;/b&gt; Calculate the last date for appearance (4 months from execution; up to 4 more with condonation), notify the applicant and the absent executants and list the document as Pending Appearance&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Sec. 34(1), (2)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1465" y="2564" width="240" height="140" as="geometry"/></mxCell><mxCell id="bring_q" value="&lt;b&gt;14a.&lt;/b&gt; How will the absent executant appear?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1480" y="2729" width="210" height="130" as="geometry"/></mxCell><mxCell id="summons" value="&lt;b&gt;14b.&lt;/b&gt; Presenter applies for a summons: issue the summons to the absent executant on payment of the peon's fee (Add Challan), have it served, and keep the document pending as Summons Issued until the date fixed; record in the Minute Book&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Sec. 36, 37, 39; Rule 23(e)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="2884" width="270" height="140" as="geometry"/></mxCell><mxCell id="comm" value="&lt;b&gt;14c.&lt;/b&gt; Executant exempt from appearing (illness or bodily infirmity, in jail, or exempt by law): visit the residence or jail, or issue a commission; keep the document pending as Commission Report Pending until the examination or the commissioner's report is recorded&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Sec. 31, 33, 38&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="2884" width="270" height="140" as="geometry"/></mxCell><mxCell id="app_dec" value="&lt;b&gt;15.&lt;/b&gt; Absent executant appeared by the last date?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1485" y="3049" width="200" height="130" as="geometry"/></mxCell><mxCell id="to_d8" value="No — time expired, executant keeping away, or presenter asks for return as to the absent executant: go to D (step 40)&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Rule 171(viii) and note to (xi); Rule 172&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1703" y="3044" width="150" height="140" as="geometry"/></mxCell><mxCell id="late" value="&lt;b&gt;16.&lt;/b&gt; Presented, or an executant appeared, more than 4 months after execution?&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;From each execution date (Sec. 23, 24); decree date / arrival in India (Sec. 23, 26); wills exempt (Sec. 27); appearance: Sec. 34(1)&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1465" y="3196" width="240" height="156" as="geometry"/></mxCell><mxCell id="late_max" value="&lt;b&gt;17.&lt;/b&gt; Delay more than 4 months beyond the time allowed?&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Rule 171(vi) / (viii)&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1475" y="3364" width="220" height="140" as="geometry"/></mxCell><mxCell id="to_d6" value="Refuse registration: go to D (step 40)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1730" y="3394" width="150" height="80" as="geometry"/></mxCell><mxCell id="late_pend" value="&lt;b&gt;18.&lt;/b&gt; Take the written condonation application (urgent necessity or unavoidable accident), suspend registration and refer it to the District Registrar whether or not the reason is satisfactory; record in the Minute Book&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Sec. 25, 34(1); Rules 46, 51, 55(i)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="765" y="3524" width="270" height="140" as="geometry"/></mxCell><mxCell id="dr1" value="District Registrar Referral Process — condonation of delay&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Separate flow: District Registrar Referral Process; resumes here with the order&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="775" y="3699" width="250" height="110" as="geometry"/></mxCell><mxCell id="condoned" value="&lt;b&gt;19.&lt;/b&gt; Order received: delay condoned and fine paid?&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Rejected / unpaid: Rule 171(vi), (viii), (xvi)&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="790" y="3839" width="220" height="150" as="geometry"/></mxCell><mxCell id="to_d7" value="Refuse registration: go to D (step 40)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="525" y="3874" width="150" height="80" as="geometry"/></mxCell><mxCell id="ident" value="&lt;b&gt;20.&lt;/b&gt; Select at least two identifiers from the witnesses, or add a new identifier" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1150" y="4022" width="200" height="104" as="geometry"/></mxCell><mxCell id="ident_ok" value="&lt;b&gt;21.&lt;/b&gt; At least two identifiers?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1580" y="4172" width="200" height="124" as="geometry"/></mxCell><mxCell id="cap_party" value="&lt;b&gt;22.&lt;/b&gt; For each party: assign the identifiers, capture the photo (camera) and thumb impression (biometric device); run Aadhaar e-KYC and name match" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1100" y="4329" width="300" height="130" as="geometry"/></mxCell><mxCell id="ekyc" value="&lt;b&gt;23.&lt;/b&gt; UIDAI e-KYC: return name, date of birth, address and photo for the name match" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1950" y="4342" width="200" height="104" as="geometry"/></mxCell><mxCell id="cap_wit" value="&lt;b&gt;24.&lt;/b&gt; For each witness / identifier: capture the photo; run Aadhaar e-KYC and name match" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1120" y="4502" width="260" height="104" as="geometry"/></mxCell><mxCell id="esign" value="&lt;b&gt;25.&lt;/b&gt; Each party and witness e-Signs at the counter, or on their own mobile through a link (Get Link)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="4654" width="240" height="120" as="geometry"/></mxCell><mxCell id="esp" value="&lt;b&gt;26.&lt;/b&gt; e-Sign service provider: Aadhaar OTP and the e-Signature" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1950" y="4662" width="200" height="104" as="geometry"/></mxCell><mxCell id="all_done" value="&lt;b&gt;27.&lt;/b&gt; Photo, thumb, e-KYC and e-Sign done for every party and witness?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1465" y="4964" width="240" height="140" as="geometry"/></mxCell><mxCell id="id_ok" value="&lt;b&gt;28.&lt;/b&gt; Executants identified and agents' authority accepted? (Sec. 34(3))" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1465" y="5119" width="240" height="150" as="geometry"/></mxCell><mxCell id="to_d3" value="Refuse registration: go to D (step 40)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1720" y="5154" width="170" height="80" as="geometry"/></mxCell><mxCell id="gen" value="&lt;b&gt;29.&lt;/b&gt; Generate the endorsement" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1150" y="5302" width="200" height="104" as="geometry"/></mxCell><mxCell id="gen_sys" value="&lt;b&gt;30.&lt;/b&gt; Generate the endorsement: presentation, fee details, presenter, admission by each executant with e-KYC details, photo, thumb and e-Sign, the identifiers and, if the delay was condoned, the Registrar's order number and date, fine and period of delay&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Rule 55(ii)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1530" y="5436" width="300" height="156" as="geometry"/></mxCell><mxCell id="review" value="&lt;b&gt;31.&lt;/b&gt; Review the endorsement together with the digitally executed deed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="5622" width="200" height="104" as="geometry"/></mxCell><mxCell id="review_ok" value="&lt;b&gt;32.&lt;/b&gt; Refusal ground found on review? (Sec. 22-B, Rule 171)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1465" y="5761" width="240" height="146" as="geometry"/></mxCell><mxCell id="to_d4" value="Refuse registration: go to D (step 40)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1720" y="5794" width="170" height="80" as="geometry"/></mxCell><mxCell id="partial" value="&lt;b&gt;33.&lt;/b&gt; Stamp duty short?&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Partial payment by the applicant, or shortfall marked at step 3 or found on review&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1465" y="5919" width="240" height="150" as="geometry"/></mxCell><mxCell id="kind" value="&lt;b&gt;34.&lt;/b&gt; Market value understated in an instrument listed in Sec. 45-A, or stamp duty short (Sec. 33)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="775" y="6079" width="250" height="150" as="geometry"/></mxCell><mxCell id="p45" value="&lt;b&gt;34a.&lt;/b&gt; Sec. 45-A: communicate the estimated market value to the parties; unless they pay duty on it, keep the process of registration pending and refer the matter with a copy of the instrument to the District Registrar; record in the Minute Book&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Sec. 45-A(1), Karnataka Stamp Act&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="485" y="6239" width="250" height="150" as="geometry"/></mxCell><mxCell id="p33" value="&lt;b&gt;34b.&lt;/b&gt; Sec. 33: impound; write &quot;Impounded under Section 33&quot; below the presentation endorsement, sign and date it; send the original to the District Registrar with the reasons, suspending registration; enter in the Register of Impounded Documents and the Minute Book&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Sec. 33, 37(2); Rules 23(a), 24(iii)(a), 46(ii)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="770" y="6239" width="260" height="150" as="geometry"/></mxCell><mxCell id="dr2" value="District Registrar Referral Process — Sec. 45-A referral / Sec. 33 impounded document&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Separate flow: District Registrar Referral Process; resumes here with the order&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="770" y="6419" width="260" height="110" as="geometry"/></mxCell><mxCell id="paid" value="&lt;b&gt;35.&lt;/b&gt; Order received and the amount due paid?&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Rule 116. Unpaid: Rule 171 (xvi)&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="785" y="6559" width="230" height="150" as="geometry"/></mxCell><mxCell id="to_d5" value="Refuse registration: go to D (step 40)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1500" y="6594" width="170" height="80" as="geometry"/></mxCell><mxCell id="dsc" value="&lt;b&gt;36.&lt;/b&gt; Sign the endorsement with the DSC: select the certificate and enter the password" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="6742" width="240" height="104" as="geometry"/></mxCell><mxCell id="ca" value="&lt;b&gt;37.&lt;/b&gt; Certifying authority: certificate valid and not revoked" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1950" y="6742" width="200" height="104" as="geometry"/></mxCell><mxCell id="register" value="&lt;b&gt;38.&lt;/b&gt; Register the document" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="6902" width="200" height="104" as="geometry"/></mxCell><mxCell id="reg_sys" value="&lt;b&gt;39.&lt;/b&gt; Generate the registration number (office–book–serial–financial year, e.g. GAN-1-00006-2026-27), attach the signed endorsement to the deed, mark Registration Completed and notify the applicant" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1520" y="7039" width="320" height="150" as="geometry"/></mxCell><mxCell id="final" value="Registered document available to the applicant for download&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Next stage: post-registration&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="7222" width="240" height="104" as="geometry"/></mxCell><mxCell id="e" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="175" y="7399" width="70" height="70" as="geometry"/></mxCell><mxCell id="d_in" value="Refusal ground found at step 5, 10, 15, 17, 19, 28, 32 or 35" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="7554" width="240" height="80" as="geometry"/></mxCell><mxCell id="juris" value="&lt;b&gt;40.&lt;/b&gt; Property outside this office's jurisdiction?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="535" y="7689" width="210" height="130" as="geometry"/></mxCell><mxCell id="ret" value="Return the document for presentation at the office having jurisdiction&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Not a refusal; no Book 2 entry (Sec. 28, Sec. 71(1))&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="785" y="7694" width="230" height="120" as="geometry"/></mxCell><mxCell id="ret_end" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="865" y="7879" width="70" height="70" as="geometry"/></mxCell><mxCell id="order" value="&lt;b&gt;41.&lt;/b&gt; Pass the refusal order: select the ground(s) under Rule 171 / Sec. 22-B and record the reasons&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Sec. 71(1), Registration Act&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="515" y="7849" width="250" height="130" as="geometry"/></mxCell><mxCell id="part_x" value="&lt;b&gt;42.&lt;/b&gt; Some executants admitted and others denied or did not appear?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1475" y="8004" width="220" height="140" as="geometry"/></mxCell><mxCell id="part_reg" value="&lt;b&gt;43.&lt;/b&gt; Register as to the executants who admitted; endorse the refusal for the others below the certificate&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Rules 106, 172 &amp;amp; 173&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1720" y="7999" width="170" height="150" as="geometry"/></mxCell><mxCell id="book2" value="&lt;b&gt;44.&lt;/b&gt; Record the reasons in Book 2 (Record of reasons for refusal to register) and endorse &quot;Registration refused&quot; on the document&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Sec. 71(1); Rule 171; Book 2 kept permanently (Rule 205)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1520" y="8164" width="320" height="140" as="geometry"/></mxCell><mxCell id="dsc2" value="&lt;b&gt;45.&lt;/b&gt; Sign the refusal order and the endorsement with the DSC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="8342" width="240" height="104" as="geometry"/></mxCell><mxCell id="notify" value="&lt;b&gt;46.&lt;/b&gt; Block re-presentation of the document in every office unless registration is directed (Sec. 71(2)); refund half the registration fee and all copying fees, but not any delay fine (Rule 193 and note); notify the presenter and return the refused document (Rule 112)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1510" y="8479" width="340" height="150" as="geometry"/></mxCell><mxCell id="recv" value="&lt;b&gt;47.&lt;/b&gt; Presenter receives the refused document; an executant or claimant may apply for a copy of the reasons" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="8654" width="260" height="120" as="geometry"/></mxCell><mxCell id="copy" value="&lt;b&gt;48.&lt;/b&gt; Issue a free copy of the recorded reasons without delay&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Sec. 71(1)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1550" y="8822" width="260" height="104" as="geometry"/></mxCell><mxCell id="denial" value="&lt;b&gt;49.&lt;/b&gt; Refused for denial of execution? (Sec. 35; Rule 187)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1555" y="8959" width="250" height="150" as="geometry"/></mxCell><mxCell id="app73" value="District Registrar Referral Process — Sec. 73 application (within 30 days)&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Separate flow: District Registrar Referral Process, section D&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="10" y="9119" width="200" height="150" as="geometry"/></mxCell><mxCell id="app72" value="District Registrar Referral Process — Sec. 72 appeal (within 30 days)&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Separate flow: District Registrar Referral Process, section D&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="220" y="9119" width="190" height="150" as="geometry"/></mxCell><mxCell id="d_end" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="175" y="9319" width="70" height="70" as="geometry"/></mxCell><mxCell id="w_in" value="Presenter asks to withdraw at step 6, or while the document is pending at step 13, 14b, 14c, 18, 34a, 34b or 35 — any time before registration (step 38)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="9464" width="320" height="100" as="geometry"/></mxCell><mxCell id="w_req" value="&lt;b&gt;50.&lt;/b&gt; Presenter submits the written withdrawal request, signed, with the reason" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="9619" width="240" height="110" as="geometry"/></mxCell><mxCell id="w_check" value="&lt;b&gt;51.&lt;/b&gt; Verify the presenter's identity and the request; record the withdrawal, date and reason in the Minute Book and approve it with the DSC&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Not a refusal: no Book 2 entry, no Sec. 71(2) block; no appeal (Rule 190)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="9764" width="300" height="140" as="geometry"/></mxCell><mxCell id="w_dr" value="&lt;b&gt;52.&lt;/b&gt; Document referred to the District Registrar (step 18, 34a or 34b)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1480" y="9924" width="210" height="140" as="geometry"/></mxCell><mxCell id="w_drn" value="District Registrar Referral Process — intimation of withdrawal; an impounded document is released only on the District Registrar's order&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Stamp duty proceedings under Sec. 33 are not closed by the withdrawal&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1725" y="9919" width="180" height="150" as="geometry"/></mxCell><mxCell id="w_sys" value="&lt;b&gt;53.&lt;/b&gt; Mark the application Withdrawn; cancel the pending appearance dates, summons, commission and appointment; remove it from the pending lists&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;The document may be presented again later&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1520" y="10089" width="320" height="130" as="geometry"/></mxCell><mxCell id="w_refund" value="&lt;b&gt;54.&lt;/b&gt; Calculate and initiate the refund: half the registration fee and all copying fees&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Not refunded here: stamp duty, delay fine, peon's fee (Rule 193 and note)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1530" y="10249" width="300" height="130" as="geometry"/></mxCell><mxCell id="w_pay" value="Payment gateway / treasury: refund to the payer's account" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1950" y="10262" width="200" height="104" as="geometry"/></mxCell><mxCell id="w_notify" value='&lt;b&gt;55.&lt;/b&gt; Endorse "Withdrawn" on the document, notify the presenter and the parties, and return the document' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1530" y="10414" width="300" height="120" as="geometry"/></mxCell><mxCell id="w_recv" value="&lt;b&gt;56.&lt;/b&gt; Presenter receives the returned document and the refund" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="10582" width="240" height="104" as="geometry"/></mxCell><mxCell id="w_end" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="175" y="10759" width="70" height="70" as="geometry"/></mxCell><mxCell id="e_s_prev_97" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s" target="prev"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_prev_open_98" value="Appointment" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="prev" target="open"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_open_show_99" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="open" target="show"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_show_check_100" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelB