<mxfile host="app.diagrams.net" type="device"><diagram id="Presentation Photo Thumb Registration" name="Presentation Photo Thumb Registration"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2240" pageHeight="5004" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lane_party" value="Parties and Witnesses&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px'&gt;At the Sub-Registrar Office&lt;/span&gt;" style="swimlane;horizontal=1;html=1;startSize=64;whiteSpace=wrap;fillColor=#dae8fc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="90" width="420" height="4724" as="geometry"/></mxCell><mxCell id="lane_sro" value="Sub-Registrar&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px'&gt;Registration Office&lt;/span&gt;" style="swimlane;horizontal=1;html=1;startSize=64;whiteSpace=wrap;fillColor=#d5e8d4;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="90" width="620" height="4724" as="geometry"/></mxCell><mxCell id="lane_deo" value="Data Entry Operator&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px'&gt;Registration Office&lt;/span&gt;" style="swimlane;horizontal=1;html=1;startSize=64;whiteSpace=wrap;fillColor=#fff2cc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1040" y="90" width="420" height="4724" as="geometry"/></mxCell><mxCell id="lane_sys" value="Kaveri System&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px'&gt;Kaveri Online Services&lt;/span&gt;" style="swimlane;horizontal=1;html=1;startSize=64;whiteSpace=wrap;fillColor=#ffe6cc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1460" y="90" width="440" height="4724" as="geometry"/></mxCell><mxCell id="lane_ext" value="External Systems&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px'&gt;UIDAI e-KYC, e-Sign service provider, DSC certifying authority&lt;/span&gt;" style="swimlane;horizontal=1;html=1;startSize=64;whiteSpace=wrap;fillColor=#f8cecc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1900" y="90" width="300" height="4724" as="geometry"/></mxCell><mxCell id="title" value="&lt;b style='font-size:20px'&gt;Document Registration — Presentation, Photo &amp;amp; Thumb Capture and Registration (v2)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;What happens at the Sub-Registrar Office after the appointment: the Sub-Registrar presents the document and records admission, the Data Entry Operator captures photos, thumb impressions and e-Signs, and the Sub-Registrar registers the document&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="2200" height="70" as="geometry"/></mxCell><mxCell id="sec_2" value="&lt;b&gt;A. PRESENTATION&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#1f4e79;" vertex="1" parent="1"><mxGeometry x="12" y="480" width="380" height="26" as="geometry"/></mxCell><mxCell id="sec_9.6" value="&lt;b&gt;B. PHOTO, THUMB AND E-SIGN&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#1f4e79;" vertex="1" parent="1"><mxGeometry x="12" y="1696.0" width="380" height="26" as="geometry"/></mxCell><mxCell id="sec_18.6" value="&lt;b&gt;C. REGISTRATION&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#1f4e79;" vertex="1" parent="1"><mxGeometry x="12" y="3136.0" width="380" height="26" as="geometry"/></mxCell><mxCell id="s" value="Start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="175" y="199" width="70" height="70" as="geometry"/></mxCell><mxCell id="prev" value="Parties and witnesses arrive at the Sub-Registrar Office at the booked appointment&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Previous stage: payment, digital signing and appointment&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="339" width="240" height="110" as="geometry"/></mxCell><mxCell id="open" value="&lt;b&gt;1.&lt;/b&gt; Open the application from the Presentation list" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="502" width="200" height="104" as="geometry"/></mxCell><mxCell id="show" value="&lt;b&gt;2.&lt;/b&gt; Show the digitally executed deed (with signature status) and the payment for each property: stamp duty, surcharge, cess, registration fee and total" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1540" y="649" width="280" height="130" as="geometry"/></mxCell><mxCell id="check" value="&lt;b&gt;3.&lt;/b&gt; Verification checklist: identity of the presenter; document details match the submitted deed; payment and stamp duty verified. Mark Agree / Disagree with remarks and save" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="809" width="300" height="130" as="geometry"/></mxCell><mxCell id="agreed" value="&lt;b&gt;4.&lt;/b&gt; All checklist items agreed?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1480" y="972" width="190" height="124" as="geometry"/></mxCell><mxCell id="reject" value="Not presented: record the remarks; the parties resolve the issue and return" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1720" y="974" width="170" height="120" as="geometry"/></mxCell><mxCell id="reject_end" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1770" y="1159" width="70" height="70" as="geometry"/></mxCell><mxCell id="present" value="&lt;b&gt;5.&lt;/b&gt; Select the presenter from the parties and present the document" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="1142" width="200" height="104" as="geometry"/></mxCell><mxCell id="rec_pres" value="&lt;b&gt;6.&lt;/b&gt; Record the presentation: presenter, date, time and office&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Presenter cannot be changed once admission is recorded (Sec. 32, Registration Act)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1550" y="1294" width="260" height="120" as="geometry"/></mxCell><mxCell id="admit" value="&lt;b&gt;7.&lt;/b&gt; Record admission of execution as each party appears and admits&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Sec. 34 &amp;amp; 35, Registration Act&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="1454" width="200" height="120" as="geometry"/></mxCell><mxCell id="admitted" value="&lt;b&gt;8.&lt;/b&gt; All parties admitted?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1580" y="1612" width="200" height="124" as="geometry"/></mxCell><mxCell id="ident" value="&lt;b&gt;9.&lt;/b&gt; Select at least two identifiers from the witnesses, or add a new identifier" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1150" y="1782" width="200" height="104" as="geometry"/></mxCell><mxCell id="ident_ok" value="&lt;b&gt;10.&lt;/b&gt; At least two identifiers?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1580" y="1932" width="200" height="124" as="geometry"/></mxCell><mxCell id="cap_party" value="&lt;b&gt;11.&lt;/b&gt; For each party: assign the identifiers, capture the photo (camera) and thumb impression (biometric device); run Aadhaar e-KYC and name match" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1100" y="2089" width="300" height="130" as="geometry"/></mxCell><mxCell id="ekyc" value="&lt;b&gt;12.&lt;/b&gt; UIDAI e-KYC: return name, date of birth, address and photo for the name match" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1950" y="2102" width="200" height="104" as="geometry"/></mxCell><mxCell id="cap_wit" value="&lt;b&gt;13.&lt;/b&gt; For each witness / identifier: capture the photo; run Aadhaar e-KYC and name match" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1120" y="2262" width="260" height="104" as="geometry"/></mxCell><mxCell id="esign" value="&lt;b&gt;14.&lt;/b&gt; Each party and witness e-Signs at the counter, or on their own mobile through a link (Get Link)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="2414" width="240" height="120" as="geometry"/></mxCell><mxCell id="esp" value="&lt;b&gt;15.&lt;/b&gt; e-Sign service provider: Aadhaar OTP and the e-Signature" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1950" y="2422" width="200" height="104" as="geometry"/></mxCell><mxCell id="all_done" value="&lt;b&gt;16.&lt;/b&gt; Photo, thumb, e-KYC and e-Sign done for every party and witness?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1560" y="2724" width="240" height="140" as="geometry"/></mxCell><mxCell id="gen" value="&lt;b&gt;17.&lt;/b&gt; Generate the endorsement" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1150" y="2902" width="200" height="104" as="geometry"/></mxCell><mxCell id="gen_sys" value="&lt;b&gt;18.&lt;/b&gt; Generate the endorsement: presentation, fee details, presenter, admission by each executant with e-KYC details, photo, thumb and e-Sign, and the identifiers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1530" y="3044" width="300" height="140" as="geometry"/></mxCell><mxCell id="review" value="&lt;b&gt;19.&lt;/b&gt; Review the endorsement together with the digitally executed deed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="3222" width="200" height="104" as="geometry"/></mxCell><mxCell id="partial" value="&lt;b&gt;20.&lt;/b&gt; Partial payment? (Sec. 45-A referral / Sec. 33 impounding)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1565" y="3366" width="230" height="136" as="geometry"/></mxCell><mxCell id="pending" value="&lt;b&gt;21.&lt;/b&gt; Keep the document pending: refer to the District Registrar (Sec. 45-A) or impound (Sec. 33); record in the Minute Book" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="780" y="3534" width="240" height="120" as="geometry"/></mxCell><mxCell id="pend_next" value="District Registrar order; deficit paid through Add Challan; registration resumes&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Next stage&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="780" y="3699" width="240" height="110" as="geometry"/></mxCell><mxCell id="pend_end" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="865" y="3879" width="70" height="70" as="geometry"/></mxCell><mxCell id="dsc" value="&lt;b&gt;22.&lt;/b&gt; Sign the endorsement with the DSC: select the certificate and enter the password" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="4022" width="240" height="104" as="geometry"/></mxCell><mxCell id="ca" value="&lt;b&gt;23.&lt;/b&gt; Certifying authority: certificate valid and not revoked" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1950" y="4022" width="200" height="104" as="geometry"/></mxCell><mxCell id="register" value="&lt;b&gt;24.&lt;/b&gt; Register the document" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="4182" width="200" height="104" as="geometry"/></mxCell><mxCell id="reg_sys" value="&lt;b&gt;25.&lt;/b&gt; Generate the registration number (office–book–serial–financial year, e.g. GAN-1-00006-2026-27), attach the signed endorsement to the deed, mark Registration Completed and notify the applicant" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1520" y="4319" width="320" height="150" as="geometry"/></mxCell><mxCell id="final" value="Registered document available to the applicant for download&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Next stage: post-registration&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="4502" width="240" height="104" as="geometry"/></mxCell><mxCell id="e" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="175" y="4679" width="70" height="70" as="geometry"/></mxCell><mxCell id="e_s_prev_42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s" target="prev"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_prev_open_43" value="Appointment" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="prev" target="open"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_open_show_44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="open" target="show"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_show_check_45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="show" target="check"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_check_agreed_46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="check" target="agreed"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_agreed_reject_47" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#b85450;fontColor=#b85450;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="agreed" target="reject"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_reject_reject_end_48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="reject" target="reject_end"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_agreed_present_49" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="agreed" target="present"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_present_rec_pres_50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="present" target="rec_pres"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_rec_pres_admit_51" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" 