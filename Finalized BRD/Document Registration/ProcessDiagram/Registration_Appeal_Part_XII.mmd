---
title: Registration Appeal – Classic Part XII (Secs. 71–77)
---
flowchart LR

    subgraph lane_citizen["Citizen"]
        direction LR
        start(("Start"))
        presentDoc["Document presented<br/>for registration"]
        getRefusalCopy["Obtains refusal order<br/>/ Book 2 copy (Sec. 71)"]
        choosePath{"Denial of<br/>execution?"}
        fileAppeal72["Sec. 72 appeal to DR<br/>within 30 days<br/>(refusal copy + original)"]
        fileApp73["Sec. 73 application<br/>to DR within 30 days<br/>(verified like plaint)"]
        presentAfterOrder["Present document again<br/>within 30 days of<br/>DR / Court order"]
        decideSuit{"File Sec. 77<br/>suit ≤ 30 days?"}
        fileSuit["Institute civil suit<br/>(Sec. 77)"]
        noSuit["No suit filed"]
        presentAfterDecree["Present within 30 days<br/>of Court decree"]
        receiveRegistered["Receives registered<br/>document"]
        endOk(("End<br/>(Registered)"))
        endRefused(("End<br/>(Finally refused)"))
        endOkDirect(("End<br/>(Registered)"))
    end

    subgraph lane_system["System"]
        direction LR
        sysBook2["Record refusal in Book 2;<br/>update status = Refused;<br/>notify citizen;<br/>generate copy"]
        sysValidateAppeal["Validate ≤ 30 days;<br/>register Sec. 72 appeal;<br/>schedule DR hearing"]
        sysValidate73["Validate ≤ 30 days;<br/>register Sec. 73 application;<br/>list for Sec. 74 enquiry"]
        sysBook2_76["Record Sec. 76 refusal<br/>in Book 2; notify citizen;<br/>copy on demand"]
        sysCheck30["Verify presentation<br/>within 30 days of<br/>order / decree"]
        sysEffectDate["Effect as of original<br/>presentation date<br/>(Sec. 75)"]
    end

    subgraph lane_sr["Sub-Registrar"]
        direction LR
        srExamine["Examine document &<br/>statutory compliance"]
        srDecide{"Admit to<br/>registration?"}
        srRegisterDirect["Admit & register<br/>document"]
        srRefuse71["Sec. 71 refusal order;<br/>reasons in Book 2;<br/>endorse; copy on demand<br/>(except wrong jurisdiction)"]
        srRegister75["Register as ordered<br/>(Sec. 75 / decree);<br/>endorsements & certificate"]
    end

    subgraph lane_dr["District Registrar"]
        direction LR
        drHear72["Hear Sec. 72 appeal<br/>(Rules 175–180)"]
        drEnquiry74["Sec. 74 enquiry:<br/>(a) executed?<br/>(b) requirements met?"]
        drDecide{"Order<br/>registration?"}
        drOrder75["Sec. 75 — Order to<br/>register; communicate"]
        drRefuse76["Sec. 76 — Refusal order;<br/>reasons in Book 2"]
    end

    subgraph lane_court["Civil Court"]
        direction LR
        courtHear["Try Sec. 77 suit"]
        courtDecide{"Decree directs<br/>registration?"}
        courtDecreeYes["Decree: register<br/>the document"]
        courtDismiss["Dismiss suit /<br/>uphold refusal"]
    end

    start --> presentDoc
    presentDoc --> srExamine
    srExamine --> srDecide
    srDecide -->|"Yes"| srRegisterDirect
    srDecide -->|"No"| srRefuse71
    srRegisterDirect --> endOkDirect
    receiveRegistered --> endOk
    srRefuse71 --> sysBook2
    sysBook2 --> getRefusalCopy
    getRefusalCopy --> choosePath
    choosePath -->|"No — other ground (Sec. 72)"| fileAppeal72
    fileAppeal72 --> sysValidateAppeal
    sysValidateAppeal --> drHear72
    drHear72 --> drDecide
    choosePath -->|"Yes — denial (Sec. 73)"| fileApp73
    fileApp73 --> sysValidate73
    sysValidate73 --> drEnquiry74
    drEnquiry74 --> drDecide
    drDecide -->|"Yes"| drOrder75
    drDecide -->|"No"| drRefuse76
    drOrder75 --> presentAfterOrder
    drRefuse76 --> sysBook2_76
    sysBook2_76 --> decideSuit
    presentAfterOrder --> sysCheck30
    sysCheck30 --> srRegister75
    srRegister75 --> sysEffectDate
    sysEffectDate --> receiveRegistered
    decideSuit -->|"Yes"| fileSuit
    decideSuit -->|"No"| noSuit
    noSuit --> endRefused
    fileSuit --> courtHear
    courtHear --> courtDecide
    courtDecide -->|"Yes"| courtDecreeYes
    courtDecide -->|"No"| courtDismiss
    courtDecreeYes --> presentAfterDecree
    presentAfterDecree --> sysCheck30
    courtDismiss --> endRefused
