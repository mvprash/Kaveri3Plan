<mxfile host="app.diagrams.net" type="device"><diagram id="Process A - Registration Application" name="Process A - Registration Application"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1140" pageHeight="2164" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lane_cit" value="Citizen / Applicant&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px'&gt;Person registering the document&lt;/span&gt;" style="swimlane;horizontal=1;html=1;startSize=64;whiteSpace=wrap;fillColor=#dae8fc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="90" width="270" height="1884" as="geometry"/></mxCell><mxCell id="lane_sys" value="Kaveri System" style="swimlane;horizontal=1;html=1;startSize=64;whiteSpace=wrap;fillColor=#d5e8d4;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="270" y="90" width="260" height="1884" as="geometry"/></mxCell><mxCell id="lane_ext" value="Outside systems&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px'&gt;KSRSAC, Bhoomi, Aadhaar&lt;/span&gt;" style="swimlane;horizontal=1;html=1;startSize=64;whiteSpace=wrap;fillColor=#fff2cc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="530" y="90" width="260" height="1884" as="geometry"/></mxCell><mxCell id="title" value="&lt;b style='font-size:20px'&gt;Process A — Filling the Document Registration Application&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;Registration core — Registration, Appointment and Status tracking (27-08-2026 discussion) — BRD Registration Core v1.0&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="790" height="70" as="geometry"/></mxCell><mxCell id="a_start" value="Start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="97" y="191" width="76" height="76" as="geometry"/></mxCell><mxCell id="a1" value="&lt;b&gt;1.&lt;/b&gt; Log in and choose “Register a document”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="35" y="329" width="200" height="100" as="geometry"/></mxCell><mxCell id="a2" value="&lt;b&gt;2.&lt;/b&gt; Answer a few simple questions about the deal (sale, gift, partition, loan …)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="35" y="479" width="200" height="100" as="geometry"/></mxCell><mxCell id="a3" value="&lt;b&gt;3.&lt;/b&gt; Suggest the matching document type (article) in plain words&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Stamp Act Schedule; Reg. Act Sec. 17&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="479" width="200" height="100" as="geometry"/></mxCell><mxCell id="a4" value="&lt;b&gt;4.&lt;/b&gt; Is the suggested document type correct?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="35" y="617" width="200" height="124" as="geometry"/></mxCell><mxCell id="a5" value="&lt;b&gt;5.&lt;/b&gt; Choose where the property is: district, taluk, village" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="35" y="779" width="200" height="100" as="geometry"/></mxCell><mxCell id="a6" value="&lt;b&gt;6.&lt;/b&gt; KSRSAC sends village details and map; Bhoomi sends survey no. and extent for farm land&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Rules 13–15&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="779" width="200" height="100" as="geometry"/></mxCell><mxCell id="a7" value="&lt;b&gt;7.&lt;/b&gt; Find the right Sub-Registrar office for this property&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Reg. Act Sec. 28&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="929" width="200" height="100" as="geometry"/></mxCell><mxCell id="a8" value="&lt;b&gt;8.&lt;/b&gt; Enter boundaries (East, West, North, South) and check the property on the map. Farm land: no size boxes&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Reg. Act Secs. 21–22&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="35" y="1079" width="200" height="100" as="geometry"/></mxCell><mxCell id="a9" value="&lt;b&gt;9.&lt;/b&gt; Add the parties (e.g. Seller and Buyer, Donor and Receiver); gender filled from Mr / Mrs&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Reg. Act Secs. 32–33&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="35" y="1229" width="200" height="100" as="geometry"/></mxCell><mxCell id="a10" value="&lt;b&gt;10.&lt;/b&gt; Aadhaar sends an OTP that names this service; each party confirms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="1229" width="200" height="100" as="geometry"/></mxCell><mxCell id="a11" value="&lt;b&gt;11.&lt;/b&gt; Pick the property type (residential, commercial, dry, wet …). The rate is not shown" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="35" y="1379" width="200" height="100" as="geometry"/></mxCell><mxCell id="a12" value="&lt;b&gt;12.&lt;/b&gt; Work out market value, stamp duty and registration fee&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Stamp Act Secs. 45-A, 45-B; Reg. Act Sec. 78&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="1529" width="200" height="100" as="geometry"/></mxCell><mxCell id="a13" value="&lt;b&gt;13.&lt;/b&gt; Check the full summary (preview) and submit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="35" y="1679" width="200" height="100" as="geometry"/></mxCell><mxCell id="a14" value="&lt;b&gt;14.&lt;/b&gt; Give an application number and send it to the Sub-Registrar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="1829" width="200" height="100" as="geometry"/></mxCell><mxCell id="a_end" value="End&lt;br&gt;Go to B" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="622" y="1841" width="76" height="76" as="geometry"/></mxCell><mxCell id="e_a_start_a1_20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a_start" target="a1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_a1_a2_21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_a2_a3_22" value="Answers" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_a3_a4_23" value="Suggestion" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_a4_a2_24" value="No — change answers" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#b85450;fontColor=#b85450;exitX=0;exitY=0.5;entryX=0;entryY=0.5;labelPosition=right;align=left;" edge="1" parent="1" source="a4" target="a2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="14" y="679"/><mxPoint x="14" y="529"/></Array><mxPoint x="6" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e_a4_a5_25" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a4" target="a5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_a5_a6_26" value="Location" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="a5" target="a6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_a6_a7_27" value="Village data" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="a6" target="a7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_a7_a8_28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="a7" target="a8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_a8_a9_29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a8" target="a9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_a9_a10_30" value="OTP request" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="a9" target="a10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_a10_a11_31" value="Verified" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="a10" target="a11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_a11_a12_32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="a11" target="a12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_a12_a13_33" value="Amounts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="a12" target="a13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_a13_a14_34" value="Submitted" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="a13" target="a14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_a14_a_end_35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="a14" target="a_end"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="legend_t" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;align=left;" vertex="1" parent="1"><mxGeometry x="0" y="2004" width="120" height="24" as="geometry"/></mxCell><mxCell id="legend_0" value="Start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="2034" width="70" height="70" as="geometry"/></mxCell><mxCell id="legend_1" value="Step done by the actor in that lane" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="2034" width="150" height="56" as="geometry"/></mxCell><mxCell id="legend_2" value="Decision / check" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="260" y="2034" width="150" height="56" as="geometry"/></mxCell><mxCell id="legend_3" value="Outside system (KSRSAC, Bhoomi, Aadhaar, Bank)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="2034" width="150" height="56" as="geometry"/></mxCell><mxCell id="legend_4" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="2034" width="70" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>