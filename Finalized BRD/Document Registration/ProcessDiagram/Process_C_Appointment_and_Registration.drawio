<mxfile host="app.diagrams.net" type="device"><diagram id="Process C - Appointment and Registration" name="Process C - Appointment and Registration"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1140" pageHeight="2464" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lane_cit" value="Citizen and Parties" style="swimlane;horizontal=1;html=1;startSize=64;whiteSpace=wrap;fillColor=#dae8fc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="90" width="300" height="2184" as="geometry"/></mxCell><mxCell id="lane_sys" value="Kaveri System" style="swimlane;horizontal=1;html=1;startSize=64;whiteSpace=wrap;fillColor=#d5e8d4;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="90" width="250" height="2184" as="geometry"/></mxCell><mxCell id="lane_sr" value="Sub-Registrar (SR)" style="swimlane;horizontal=1;html=1;startSize=64;whiteSpace=wrap;fillColor=#fff2cc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="550" y="90" width="250" height="2184" as="geometry"/></mxCell><mxCell id="lane_dr" value="District Registrar (DR)" style="swimlane;horizontal=1;html=1;startSize=64;whiteSpace=wrap;fillColor=#ffe6cc;swimlaneFillColor=#fcfcfc;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="800" y="90" width="250" height="2184" as="geometry"/></mxCell><mxCell id="title" value="&lt;b style='font-size:20px'&gt;Process C — Appointment and Registration at the Sub-Registrar Office&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;Registration core — Registration, Appointment and Status tracking (27-08-2026 discussion) — BRD Registration Core v1.0&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="1050" height="70" as="geometry"/></mxCell><mxCell id="c_start" value="Start&lt;br&gt;from B" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="112" y="191" width="76" height="76" as="geometry"/></mxCell><mxCell id="c0" value="Keep office working days, holidays and daily slot limits up to date&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Rules 3, 5&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="825" y="179" width="200" height="100" as="geometry"/></mxCell><mxCell id="c1" value="&lt;b&gt;1.&lt;/b&gt; Pick a date and time at the Sub-Registrar office" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="329" width="200" height="100" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;2.&lt;/b&gt; Within 4 months of signing the document?&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Sec. 23&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="325" y="467" width="200" height="124" as="geometry"/></mxCell><mxCell id="c2w" value="See the late-fee warning; accept the fine or pick an earlier date&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Sec. 25; Rules 51–55&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="479" width="200" height="100" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;3.&lt;/b&gt; Confirm the slot; send SMS and an appointment slip with QR code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="325" y="629" width="200" height="100" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;4.&lt;/b&gt; Can all parties come on that day?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="767" width="200" height="124" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;5.&lt;/b&gt; Come to the office on the day; scan the QR code at the kiosk" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="929" width="200" height="100" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;6.&lt;/b&gt; Mark presence and add to the SR’s queue in slot order" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="325" y="929" width="200" height="100" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;7.&lt;/b&gt; Call the parties; note the time the document is presented&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Sec. 52&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="575" y="1079" width="200" height="100" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;8.&lt;/b&gt; Full stamp duty paid and value not too low?&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Stamp Act Secs. 33–39, 45-A&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="575" y="1217" width="200" height="124" as="geometry"/></mxCell><mxCell id="c8x" value="Document held — impound / value check (separate process)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="825" y="1229" width="200" height="100" as="geometry"/></mxCell><mxCell id="c_end_x" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="887" y="1391" width="76" height="76" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;9.&lt;/b&gt; All parties present and agree they signed?&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Secs. 34–35&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="575" y="1367" width="200" height="124" as="geometry"/></mxCell><mxCell id="c9x" value="Kept pending in the Minute Book; parties book a new date&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Rules 51–55&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="325" y="1379" width="200" height="100" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;10.&lt;/b&gt; Take photo and fingerprints of all parties&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Sec. 32A; Rule 40&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="575" y="1529" width="200" height="100" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;11.&lt;/b&gt; Parties sign the endorsements&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Secs. 58–59&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="1679" width="200" height="100" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;12.&lt;/b&gt; Click “Check and Register”; sign the certificate digitally&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Sec. 60&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="575" y="1829" width="200" height="100" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;13.&lt;/b&gt; Give the registration number, update books and index, scan the document&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Sec. 51&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="325" y="1979" width="200" height="100" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;14.&lt;/b&gt; Return the registered document and digital copy&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Sec. 61; Rules 110–118&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="575" y="2129" width="200" height="100" as="geometry"/></mxCell><mxCell id="c_end" value="End&lt;br&gt;Registered" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="112" y="2141" width="76" height="76" as="geometry"/></mxCell><mxCell id="e_c_start_c1_26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c_start" target="c1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_c1_c2_27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_c2_c2w_28" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#b85450;fontColor=#b85450;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c2" target="c2w"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_c2w_c3_29" value="Accept fine" 