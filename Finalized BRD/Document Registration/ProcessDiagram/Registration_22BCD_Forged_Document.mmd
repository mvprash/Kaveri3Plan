---
title: Karnataka Secs. 22-B / 22-C / 22-D — Forged / Prohibited Documents
---
flowchart LR

    subgraph lane_citizen["Citizen"]
        direction LR
        start(("Start"))
        presentDoc["Document presented<br/>for registration"]
        getRefusal22B["Obtains Sec. 22-B<br/>refusal / Book 2 copy"]
        endRefused22B(("End<br/>(Refused 22-B)"))
        receiveRegistered["Receives registered<br/>document"]
        endOkDirect(("End<br/>(Registered)<br/>(may face 22-C later)"))
        start22C(("Start<br/>(Sec. 22-C)"))
        fileComplaint["Aggrieved person files<br/>complaint under Sec. 22-C<br/>(or DR acts suo motu)"]
        replyShowCause["Executants / parties<br/>reply to show-cause<br/>notice"]
        decideAppeal22D{"File Sec. 22-D<br/>appeal ≤ 30 days?"}
        fileAppeal22D["Appeal to IGR<br/>within 30 days of<br/>cancellation (Sec. 22-D)"]
        noAppeal["No appeal filed"]
        endCancelled(("End<br/>(Cancelled stands)"))
        receiveRestored["Registration restored<br/>/ status updated"]
        endRestored(("End<br/>(Restored)"))
        decideCourt{"Further challenge<br/>in Civil Court?"}
        fileSuit["Institute civil suit<br/>/ writ petition"]
        endAfterIgr(("End<br/>(IGR order final<br/>departmentally)"))
        endStands(("End<br/>(Registration stands)"))
        endCourtOk(("End<br/>(Court restored)"))
        endCourtNo(("End<br/>(Cancellation final)"))
    end

    subgraph lane_system["System"]
        direction LR
        sysScreen22B["Screen for Sec. 22-B:<br/>forged / prohibited /<br/>attached property /<br/>notified class"]
        sysBook2_22B["Record Sec. 22-B refusal<br/>in Book 2; status =<br/>Refused (22-B); notify;<br/>generate copy"]
        sysRegisterComplaint["Register complaint /<br/>suo-motu case;<br/>Limitation Act check<br/>(+ condonation flag)"]
        sysServeNotice["Serve show-cause<br/>notices; track replies<br/>& affected parties"]
        sysEnterCancel["Enter cancellation in<br/>relevant books & indexes;<br/>update status; notify<br/>parties (Rule 17(iii))"]
        sysClose22C["Close 22-C case;<br/>registration stands;<br/>notify complainant"]
        sysValidateAppeal["Validate ≤ 30 days;<br/>register Sec. 22-D<br/>appeal; list for IGR"]
        sysApplyIgr["Apply IGR order:<br/>confirm / modify /<br/>restore registration<br/>in books & indexes"]
    end

    subgraph lane_sr["Sub-Registrar"]
        direction LR
        srExamine["Examine document &<br/>Sec. 22-B compliance<br/>(title disputes excluded)"]
        srDecide22B{"Hits Sec. 22-B<br/>grounds?"}
        srRefuse22B["Sec. 22-B — Refuse<br/>registration (forged /<br/>prohibited / attached /<br/>notified)"]
        srRegister["Admit & register<br/>document<br/>(subject to later 22-C)"]
    end

    subgraph lane_dr["District Registrar"]
        direction LR
        drTrigger["Sec. 22-C trigger:<br/>suo motu OR complaint<br/>from aggrieved person"]
        drOpinion{"Opinion: registered<br/>in contravention of<br/>Sec. 22-B?"}
        drShowCause["Issue show-cause notice<br/>to executants, parties,<br/>subsequent parties &<br/>affected persons"]
        drDecideCancel{"Cancel<br/>registration?"}
        drCancel["Sec. 22-C — Cancel<br/>registration; order<br/>to books & indexes"]
        drNoCancel["Drop / refuse to cancel;<br/>registration continues"]
    end

    subgraph lane_igr["IGR"]
        direction LR
        igrHear["Hear Sec. 22-D appeal<br/>(within limitation +<br/>condonation if any)"]
        igrDecide{"IGR order<br/>(confirm / modify /<br/>cancel DR order)"}
        igrConfirm["Confirm DR<br/>cancellation"]
        igrSetAside["Cancel / modify DR<br/>order — restore or<br/>amend registration"]
    end

    subgraph lane_court["Civil Court"]
        direction LR
        courtHear["Try civil suit /<br/>writ against IGR<br/>(or DR) order"]
        courtDecide{"Court directs<br/>restore / uphold?"}
        courtRestore["Decree / order:<br/>restore registration"]
        courtUphold["Dismiss / uphold<br/>cancellation"]
    end

    start --> presentDoc
    presentDoc --> sysScreen22B
    sysScreen22B --> srExamine
    srExamine --> srDecide22B
    srDecide22B -->|"Yes"| srRefuse22B
    srDecide22B -->|"No"| srRegister
    srRefuse22B --> sysBook2_22B
    sysBook2_22B --> getRefusal22B
    getRefusal22B --> endRefused22B
    srRegister --> receiveRegistered
    receiveRegistered --> endOkDirect
    start22C --> fileComplaint
    fileComplaint --> drTrigger
    drTrigger --> sysRegisterComplaint
    sysRegisterComplaint --> drOpinion
    drOpinion -->|"Yes"| drShowCause
    drOpinion -->|"No"| sysClose22C
    sysClose22C --> endStands
    drShowCause --> sysServeNotice
    sysServeNotice --> replyShowCause
    replyShowCause --> drDecideCancel
    drDecideCancel -->|"Yes"| drCancel
    drDecideCancel -->|"No"| drNoCancel
    drNoCancel --> sysClose22C
    drCancel --> sysEnterCancel
    sysEnterCancel --> decideAppeal22D
    decideAppeal22D -->|"Yes"| fileAppeal22D
    decideAppeal22D -->|"No"| noAppeal
    noAppeal --> endCancelled
    fileAppeal22D --> sysValidateAppeal
    sysValidateAppeal --> igrHear
    igrHear --> igrDecide
    igrDecide -->|"Confirm"| igrConfirm
    igrDecide -->|"Cancel / modify"| igrSetAside
    igrConfirm --> sysApplyIgr
    igrSetAside --> sysApplyIgr
    sysApplyIgr -->|"Restored / modified"| receiveRestored
    sysApplyIgr -->|"Confirmed cancel"| decideCourt
    receiveRestored --> endRestored
    decideCourt -->|"Yes"| fileSuit
    decideCourt -->|"No"| endAfterIgr
    fileSuit --> courtHear
    courtHear --> courtDecide
    courtDecide -->|"Restore"| courtRestore
    courtDecide -->|"Uphold"| courtUphold
    courtRestore --> endCourtOk
    courtUphold --> endCourtNo
