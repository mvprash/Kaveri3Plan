  <diagram id="i5CfSsY2HUp60h0dk1aT" name="EndorsementGeneration_J">
    <mxGraphModel dx="1120" dy="434" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="mMaqX280pQ4_rl9SI_Ur-1" value="" style="group" parent="1" vertex="1" connectable="0">
          <mxGeometry x="50" y="20" width="760" height="80" as="geometry" />
        </mxCell>
        <mxCell id="mMaqX280pQ4_rl9SI_Ur-2" value="" style="group;strokeColor=none;" parent="mMaqX280pQ4_rl9SI_Ur-1" vertex="1" connectable="0">
          <mxGeometry x="30" width="735.68" height="70" as="geometry" />
        </mxCell>
        <mxCell id="mMaqX280pQ4_rl9SI_Ur-3" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;br&gt;&lt;/h1&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fillColor=#1ba1e2;strokeColor=#006EAF;fontColor=#ffffff;" parent="mMaqX280pQ4_rl9SI_Ur-2" vertex="1">
          <mxGeometry width="735.68" height="70" as="geometry" />
        </mxCell>
        <mxCell id="mMaqX280pQ4_rl9SI_Ur-4" value="&lt;span style=&quot;font-size: 26px;&quot;&gt;&lt;b&gt;Different types of Endorsements&lt;/b&gt;&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#fcfcfc;" parent="mMaqX280pQ4_rl9SI_Ur-2" vertex="1">
          <mxGeometry x="55.733333333333334" y="24.0625" width="579.6266666666668" height="21.875" as="geometry" />
        </mxCell>
        <mxCell id="mMaqX280pQ4_rl9SI_Ur-5" value="&lt;font style=&quot;font-size: 35px;&quot;&gt;J&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;strokeWidth=2;fontFamily=Tahoma;spacingBottom=4;spacingRight=2;strokeColor=#001DBC;fillColor=#0050ef;fontColor=#ffffff;" parent="mMaqX280pQ4_rl9SI_Ur-1" vertex="1">
          <mxGeometry width="70" height="70" as="geometry" />
        </mxCell>
        <mxCell id="Pn5BoV0r41lQ2sSvzfK4-11" value="&lt;span style=&quot;font-size: 12px;&quot;&gt;1. Pending for determination of undervaluation, referred to District Registrar u/s 45A of KS Act 1957.&lt;/span&gt;&lt;div style=&quot;font-size: 12px;&quot;&gt;&lt;br style=&quot;font-size: 12px;&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 12px;&quot;&gt;&lt;span style=&quot;font-size: 12px; background-color: initial;&quot;&gt;2. Pending for short levy of Stamp Duty, impounded u/s 33 of KS Act 1957.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 12px;&quot;&gt;&lt;span style=&quot;font-size: 12px; background-color: initial;&quot;&gt;&lt;br style=&quot;font-size: 12px;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 12px;&quot;&gt;&lt;div style=&quot;font-size: 12px;&quot;&gt;3. Pending for condonation of delay, u/s 25 of KS Act 1957, document exceeding 4 months from the date of last execution read with Rule 52 of Registration Act 1908.&lt;/div&gt;&lt;div style=&quot;font-size: 12px;&quot;&gt;After 4 months from the Date of Execution&lt;/div&gt;&lt;div style=&quot;font-size: 12px;&quot;&gt;Not exceeding one week – penalty equal to fee (1 time)&lt;/div&gt;&lt;div style=&quot;font-size: 12px;&quot;&gt;Exceeding one week not exceeding one month – penalty equal to 2 times the fees&lt;/div&gt;&lt;div style=&quot;font-size: 12px;&quot;&gt;Exceeding one month not exceeding two months – penalty equal to 5 times the fees&lt;/div&gt;&lt;div style=&quot;font-size: 12px;&quot;&gt;Exceeding two months not exceeding four months – penalty equal to 10 times the fees&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 12px;&quot;&gt;&lt;br style=&quot;font-size: 12px;&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 12px;&quot;&gt;&lt;div style=&quot;font-size: 12px;&quot;&gt;4. Pending for appearance of the parties, u/s 34 of Registration Act 1908.&lt;span style=&quot;background-color: initial; font-size: 12px;&quot;&gt;party appearing on different time for admission of execution. So, document can be kept pending up&amp;nbsp; to 4 months from the date of execution. On appearance for admission of execution should be&amp;nbsp; identified by two witnesses. So, provision can be made to print on the endorsement “Document kept pending for appearance of the party”. “On appearance of the party, the pending shall be opened and thumb and photos could be taken and date of appearance should come in the endorsement along with two witnesses to be added in the endorsement&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial; font-size: 12px;&quot;&gt;If one of the party is not appearing, document can be registered to the extent of&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 12px;&quot;&gt;parties appearing for admission and partially refused to the extent of parties not&amp;nbsp;&lt;span style=&quot;background-color: initial; font-size: 12px;&quot;&gt;appeared&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 12px;&quot;&gt;&lt;br style=&quot;font-size: 12px;&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 12px;&quot;&gt;&lt;div style=&quot;font-size: 12px;&quot;&gt;5. Pending for private attendance u/s 31 of Registration Act 1908.&lt;span style=&quot;background-color: initial; font-size: 12px;&quot;&gt;Document kept pending for attending private residence of the party After visiting the residence of the party&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial; font-size: 12px;&quot;&gt;the admission of execution of the party taken on this date and time and place shall be recorded on the endorsement along with the two witness and deposition shall be recorded in the minute book&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="20" y="170" width="410" height="530" as="geometry" />
        </mxCell>
        <mxCell id="Pn5BoV0r41lQ2sSvzfK4-12" value="&lt;font style=&quot;font-size: 12px;&quot;&gt;1.&amp;nbsp;The document is refused to register as per sec 19 read with rule 171 (i) of the Registration act 1908 and Karnataka Registration Rules 1965.&lt;/font&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;br style=&quot;&quot;&gt;&lt;/font&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;2.&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;The document is refused to register as per sec 20 read with rule 171 (ii) the Registration act 1908 and Karnataka Registration Rules 1965.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;br style=&quot;&quot;&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;3.&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;The document is refused to register as per sec 21(1) to (3) and sec 22 read with rule 171 (iii) the Registration act 1908 and Karnataka Registration Rules 1965.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;br style=&quot;&quot;&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;4.&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;The document is refused to register as per sec 21(4) read with rule 171 (iv) the Registration act 1908 and Karnataka Registration Rules 1965.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;br style=&quot;&quot;&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;5.&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;The document is refused to register as per rule 50 read with rule 171 (v) the Registration act 1908 and Karnataka Registration Rules 1965.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;br style=&quot;&quot;&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;6.&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;The document is refused to register as per sec 23, 24, 25, 26, 72, 75 and 77 read with rule 171 (vi) the Registration act 1908 and Karnataka Registration Rules 1965.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;br style=&quot;&quot;&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;7.&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;The document is refused to register as per sec 32, 33, 40 and 43 read with rule 171 (vii) the Registration act 1908 and Karnataka Registration Rules 1965.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;br style=&quot;&quot;&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;8.&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;The document is refused to registered as per sec 34 read with rule 171 (viii) the Registration act 1908 and Karnataka Registration Rules 1965.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;br style=&quot;&quot;&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;9.&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;The document is refused to register as per sec 34 and 43 read with rule 171 (ix) the Registration act 1908 and Karnataka Registration Rules 1965.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;br style=&quot;&quot;&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;10.&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;The document is refused to register as per sec 34 and 40 read with rule 171 (x) the Registration act 1908 and Karnataka Registration Rules 1965.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;br style=&quot;&quot;&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;11.&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;The document is refused to register